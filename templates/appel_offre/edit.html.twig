{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Modifier Appel d'offre{% endblock %}

{% block body %}
    <main class="ww-page">
        <section class="ww-shell">

            <div class="ww-grid ww-grid-back">
                <article class="ww-card">
                    <h2 class="ww-section-title">Modifier l'appel d'offre</h2>
                    <div class="mb-3">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Retour
                        </a>
                    </div>
                    {{ include('appel_offre/_form.html.twig', {'button_label': 'Mettre a jour'}) }}
                    <div class="ww-links">
                        {{ include('appel_offre/_delete_form.html.twig') }}
                    </div>
                </article>
            </div>
        </section>
    </main>
{% endblock %}
