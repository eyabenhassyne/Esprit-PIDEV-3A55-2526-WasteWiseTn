{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Nouvel appel d'offre | WasteWise{% endblock %}
{% block page_title %}Nouvel appel d'offre{% endblock %}

{% block body %}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="mb-1" style="font-size:1.45rem;font-weight:800;color:#0f2d1e;">
      <i class="fa-solid fa-plus me-2" style="color:#2f6b4f;"></i>Créer un appel d'offre
    </h2>
    <p class="mb-0" style="color:#6b7280;font-size:.9rem;">Publiez un nouvel appel pour la collecte ou la valorisation</p>
  </div>
  <a href="{{ path('app_appel_offre_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
    <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
  </a>
</div>

<div style="background:#fff;border-radius:18px;box-shadow:0 5px 20px rgba(0,0,0,.07);border:1px solid rgba(0,0,0,.04);overflow:hidden;max-width:760px;">
  <div style="padding:16px 22px;font-weight:700;font-size:.95rem;color:#0f2d1e;border-bottom:1px solid rgba(0,0,0,.06);background:#f9fafb;">
    <i class="fa-solid fa-file-contract me-2" style="color:#2f6b4f;"></i>Formulaire
  </div>
  <div style="padding:26px;">
    {{ include('appel_offre/_form.html.twig') }}
    <div class="mt-3">
      <a class="btn btn-outline-secondary rounded-pill px-4" href="{{ path('app_appel_offre_index') }}">
        <i class="fa-solid fa-xmark me-1"></i> Annuler
      </a>
    </div>
  </div>
</div>

{% endblock %}
