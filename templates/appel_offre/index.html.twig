{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Appels d'offre | WasteWise{% endblock %}
{% block page_title %}Appels d'offre{% endblock %}

{% block body %}

{# ── Hero ── #}
<section class="hero mb-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-1">Appels d'offre</h2>
      <p class="mb-0 opacity-75">Consultez et gérez les appels d'offre de valorisation.</p>
    </div>
    {% if is_granted('ROLE_VALORIZER') %}
      <a href="{{ path('app_appel_offre_new') }}" class="btn btn-light fw-semibold rounded-pill px-4">
        <i class="fa-solid fa-plus me-2"></i>Nouvel appel
      </a>
    {% endif %}
  </div>
</section>

{# ── Flash messages ── #}
{% for label, messages in app.flashes %}
  {% for message in messages %}
    {% set bs = label == 'error' ? 'danger' : label %}
    <div class="alert alert-{{ bs }} shadow-sm mb-3">{{ message }}</div>
  {% endfor %}
{% endfor %}

{# ── Filters ── #}
<div class="big-card mb-4">
  <form method="get" id="filterForm">
    <div class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label fw-semibold small text-muted text-uppercase">Recherche</label>
        <input type="text" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Titre ou description…">
      </div>
      <div class="col-md-2">
        <label class="form-label fw-semibold small text-muted text-uppercase">Quantité min</label>
        <input type="number" step="0.01" name="quantite_min" value="{{ quantite_min|default('') }}" class="form-control" placeholder="Ex: 100">
      </div>
      <div class="col-md-2">
        <label class="form-label fw-semibold small text-muted text-uppercase">État</label>
        <select name="etat" class="form-select">
          <option value="">Tous</option>
          <option value="active"   {{ etat == 'active'   ? 'selected' : '' }}>Active</option>
          <option value="expiree"  {{ etat == 'expiree'  ? 'selected' : '' }}>Expirée</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label fw-semibold small text-muted text-uppercase">Trier par</label>
        <select name="sort" class="form-select">
          <option value="dateLimite"        {{ sort == 'dateLimite'        ? 'selected' : '' }}>Date limite</option>
          <option value="titre"             {{ sort == 'titre'             ? 'selected' : '' }}>Titre</option>
          <option value="quantiteDemandee"  {{ sort == 'quantiteDemandee'  ? 'selected' : '' }}>Quantité</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label fw-semibold small text-muted text-uppercase">Ordre</label>
        <select name="direction" class="form-select">
          <option value="DESC" {{ direction == 'DESC' ? 'selected' : '' }}>Décroissant</option>
          <option value="ASC"  {{ direction == 'ASC'  ? 'selected' : '' }}>Croissant</option>
        </select>
      </div>
    </div>
    <div class="d-flex gap-2 mt-3">
      <button type="submit" class="btn btn-vert rounded-pill px-4">
        <i class="fa-solid fa-magnifying-glass me-2"></i>Appliquer
      </button>
      <a href="{{ path('app_appel_offre_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-solid fa-rotate-left me-2"></i>Réinitialiser
      </a>
    </div>
  </form>
</div>

{# ── Table card ── #}
<div class="big-card">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div>
      <h5 class="mb-0 fw-bold">Liste des appels d'offre</h5>
      <small class="text-muted">{{ appel_offres|length }} résultat(s)</small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button" id="ww-export-appel-table-pdf">
        <i class="fa-solid fa-file-pdf me-1"></i>PDF
      </button>
      <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button" id="ww-export-appel-table-excel">
        <i class="fa-solid fa-file-excel me-1"></i>Excel
      </button>
      <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button" id="ww-export-appel-table-word">
        <i class="fa-solid fa-file-word me-1"></i>Word
      </button>
      <div class="d-flex align-items-center gap-2 ms-2">
        <span class="small text-muted">Afficher</span>
        <select id="ww-appel-page-size" class="form-select form-select-sm" style="width:75px;">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="20">20</option>
          <option value="50">50</option>
        </select>
        <span class="small text-muted">lignes</span>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="ww-appel-table">
      <thead class="table-light">
        <tr>
          <th class="text-muted small">#</th>
          <th class="small">Titre</th>
          <th class="small">Description</th>
          <th class="small text-center">Quantité</th>
          <th class="small">Date limite</th>
          <th class="small text-center">État</th>
          <th class="small text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for ao in appel_offres %}
          <tr data-ww-row="1" style="cursor:pointer;" onclick="window.location='{{ path('app_appel_offre_show', {'id': ao.id}) }}'">
            <td class="text-muted small">#{{ ao.id }}</td>
            <td class="fw-semibold">{{ ao.titre }}</td>
            <td class="text-muted small" style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              {{ ao.description|default('—') }}
            </td>
            <td class="text-center fw-semibold">{{ ao.quantiteDemandee }}</td>
            <td class="small">
              {% if ao.dateLimite %}
                <i class="fa-regular fa-calendar me-1 text-muted"></i>
                {{ ao.dateLimite|date('d/m/Y') }}
                <span class="text-muted">{{ ao.dateLimite|date('H:i') }}</span>
              {% else %}—{% endif %}
            </td>
            <td class="text-center">
              {% if ao.expired %}
                <span class="badge rounded-pill" style="background:#fee2e2;color:#991b1b;font-size:.78rem;padding:.35rem .75rem;">
                  <i class="fa-solid fa-circle-xmark me-1"></i>Expirée
                </span>
              {% else %}
                <span class="badge rounded-pill" style="background:#dcfce7;color:#166534;font-size:.78rem;padding:.35rem .75rem;">
                  <i class="fa-solid fa-circle-check me-1"></i>Active
                </span>
              {% endif %}
            </td>
            <td class="text-end" onclick="event.stopPropagation()">
              <a href="{{ path('app_appel_offre_show', {'id': ao.id}) }}"
                 class="btn btn-sm btn-outline-success rounded-pill px-3 me-1">
                <i class="fa-solid fa-eye me-1"></i>Voir
              </a>
              {% if not ao.expired and is_granted('ROLE_VALORIZER') %}
                <a href="{{ path('app_appel_offre_edit', {'id': ao.id}) }}"
                   class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                  <i class="fa-solid fa-pen me-1"></i>Modifier
                </a>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-25"></i>
              Aucun appel d'offre trouvé.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Pagination #}
  <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <span class="small text-muted" id="ww-appel-page-info">—</span>
    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" id="ww-appel-page-prev">
        <i class="fa-solid fa-chevron-left me-1"></i>Précédent
      </button>
      <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" id="ww-appel-page-next">
        Suivant<i class="fa-solid fa-chevron-right ms-1"></i>
      </button>
    </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(() => {
  const table       = document.getElementById('ww-appel-table');
  if (!table) return;

  const pageSizeEl  = document.getElementById('ww-appel-page-size');
  const pageInfoEl  = document.getElementById('ww-appel-page-info');
  const prevBtn     = document.getElementById('ww-appel-page-prev');
  const nextBtn     = document.getElementById('ww-appel-page-next');
  const exportPdf   = document.getElementById('ww-export-appel-table-pdf');
  const exportExcel = document.getElementById('ww-export-appel-table-excel');
  const exportWord  = document.getElementById('ww-export-appel-table-word');
  const storageKey  = 'ww.appel.table.page_size';

  const bodyRows = Array.from(table.querySelectorAll('tbody tr[data-ww-row="1"]'));
  let currentPage = 1;

  const saved = localStorage.getItem(storageKey);
  if (saved && pageSizeEl.querySelector(`option[value="${saved}"]`)) pageSizeEl.value = saved;

  const getPageSize = () => { const n = parseInt(pageSizeEl.value, 10); return isFinite(n) && n > 0 ? n : 10; };

  const render = () => {
    if (!bodyRows.length) {
      pageInfoEl.textContent = 'Aucun résultat';
      prevBtn.disabled = nextBtn.disabled = true;
      return;
    }
    const ps = getPageSize();
    const total = Math.max(1, Math.ceil(bodyRows.length / ps));
    currentPage = Math.min(Math.max(currentPage, 1), total);
    const start = (currentPage - 1) * ps;
    bodyRows.forEach((r, i) => r.style.display = (i >= start && i < start + ps) ? '' : 'none');
    pageInfoEl.textContent = `Page ${currentPage} / ${total} (${bodyRows.length} ligne${bodyRows.length > 1 ? 's' : ''})`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= total;
  };

  pageSizeEl.addEventListener('change', () => { currentPage = 1; localStorage.setItem(storageKey, pageSizeEl.value); render(); });
  prevBtn.addEventListener('click', () => { currentPage--; render(); });
  nextBtn.addEventListener('click', () => { currentPage++; render(); });

  const getTableData = () => {
    const headers = Array.from(table.querySelectorAll('thead th'))
      .map(th => th.textContent.trim())
      .filter(h => h && h.toLowerCase() !== 'actions');
    const rows = bodyRows.map(row =>
      Array.from(row.querySelectorAll('td')).reduce((acc, cell, i) => {
        const h = (table.querySelectorAll('thead th')[i]?.textContent || '').trim().toLowerCase();
        if (h !== 'actions') acc.push(cell.textContent.replace(/\s+/g, ' ').trim());
        return acc;
      }, [])
    );
    return { headers, rows };
  };

  const download = (blob, name) => {
    const url = URL.createObjectURL(blob);
    const a = Object.assign(document.createElement('a'), { href: url, download: name });
    document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
  };

  const loadScript = (key, src, global) => new Promise((res, rej) => {
    if (window[global]) return res();
    const existing = document.querySelector(`script[data-ww-lib="${key}"]`);
    if (existing) { existing.addEventListener('load', res, { once: true }); return; }
    const s = document.createElement('script');
    s.src = src; s.async = true; s.setAttribute('data-ww-lib', key);
    s.addEventListener('load', res, { once: true });
    s.addEventListener('error', () => rej(new Error(`Failed: ${src}`)), { once: true });
    document.head.appendChild(s);
  });

  const setBusy = (btn, busy, label) => { btn.disabled = busy; btn.innerHTML = busy ? '<i class="fa-solid fa-spinner fa-spin me-1"></i>Génération…' : label; };

  exportWord?.addEventListener('click', () => {
    const lbl = exportWord.innerHTML;
    setBusy(exportWord, true, lbl);
    const { headers, rows } = getTableData();
    const tbl = `<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;width:100%;font-family:Arial,sans-serif;">
      <thead><tr>${headers.map(h => `<th style="background:#eaf5ee;">${h}</th>`).join('')}</tr></thead>
      <tbody>${rows.map(r => `<tr>${r.map(v => `<td>${v}</td>`).join('')}</tr>`).join('')}</tbody>
    </table>`;
    const html = `<html><head><meta charset="utf-8"></head><body><h2>Appels d'offre</h2><p>${new Date().toLocaleString('fr-FR')}</p>${tbl}</body></html>`;
    download(new Blob(['\ufeff', html], { type: 'application/msword' }), 'appels-offre.doc');
    setTimeout(() => setBusy(exportWord, false, lbl), 300);
  });

  exportExcel?.addEventListener('click', async () => {
    const lbl = exportExcel.innerHTML;
    setBusy(exportExcel, true, lbl);
    try {
      await loadScript('xlsx', 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js', 'XLSX');
      const { headers, rows } = getTableData();
      const ws = window.XLSX.utils.aoa_to_sheet([headers, ...rows]);
      const wb = window.XLSX.utils.book_new();
      window.XLSX.utils.book_append_sheet(wb, ws, 'Appels');
      window.XLSX.writeFile(wb, 'appels-offre.xlsx');
    } catch(e) { console.error(e); alert("Export Excel échoué."); }
    finally { setBusy(exportExcel, false, lbl); }
  });

  exportPdf?.addEventListener('click', async () => {
    const lbl = exportPdf.innerHTML;
    setBusy(exportPdf, true, lbl);
    try {
      await loadScript('html2pdf', 'https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js', 'html2pdf');
      const { headers, rows } = getTableData();
      const wrapper = document.createElement('div');
      wrapper.style.padding = '12px';
      wrapper.innerHTML = `<h2 style="margin:0 0 8px;">Appels d'offre</h2>
        <p style="margin:0 0 14px;color:#526d61;">${new Date().toLocaleString('fr-FR')}</p>
        <table style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:12px;">
          <thead><tr>${headers.map(h => `<th style="border:1px solid #c9ddd2;padding:7px;background:#edf8f2;text-align:left;">${h}</th>`).join('')}</tr></thead>
          <tbody>${rows.map(r => `<tr>${r.map(v => `<td style="border:1px solid #d9e8df;padding:7px;">${v}</td>`).join('')}</tr>`).join('')}</tbody>
        </table>`;
      await window.html2pdf().set({
        margin:[8,8,8,8], filename:'appels-offre.pdf',
        image:{type:'jpeg',quality:.98},
        html2canvas:{scale:2,useCORS:true,backgroundColor:'#fff'},
        jsPDF:{unit:'mm',format:'a4',orientation:'landscape'}
      }).from(wrapper).save();
    } catch(e) { console.error(e); alert("Export PDF échoué."); }
    finally { setBusy(exportPdf, false, lbl); }
  });

  render();
})();
</script>
{% endblock %}
