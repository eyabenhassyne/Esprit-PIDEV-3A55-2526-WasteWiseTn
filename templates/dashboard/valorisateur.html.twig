{% extends 'valorisateur/base_valorizateur.html.twig' %}

{% block title %}Dashboard Valorisateur | WasteWise TN{% endblock %}

{% block body %}

{# ── En-tête ── #}
<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-4">
  <div>
    <h3 class="mb-1">🏭 Dashboard Valorisateur</h3>
    <div class="text-muted small">Espace utilisateur</div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    {% set base = app.request.baseUrl %}
    <a class="btn btn-outline-secondary" href="{{ base ~ '/valorisateur/profil' }}">
      <i class="bi bi-person"></i> Mon profil
    </a>
    <a class="btn btn-success" href="{{ base ~ '/valorisateur/profil/modifier' }}">
      <i class="bi bi-pencil"></i> Modifier
    </a>
  </div>
</div>

{# ── Infos compte ── #}
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body d-flex align-items-start justify-content-between">
        <div>
          <div class="text-muted small">Email</div>
          <div class="fw-bold">{{ app.user ? app.user.userIdentifier : '—' }}</div>
          <div class="small text-muted">Identifiant de connexion</div>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center"
             style="width:44px;height:44px;background:#ecfdf5;">
          <i class="bi bi-envelope text-success"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body d-flex align-items-start justify-content-between">
        <div>
          <div class="text-muted small">Type</div>
          <div class="fw-bold">
            {% if app.user and attribute(app.user, 'type') is defined %}
              {{ app.user.type }}
            {% else %}
              VALORIZER
            {% endif %}
          </div>
          <div class="small text-muted">Profil actuel</div>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center"
             style="width:44px;height:44px;background:#eff6ff;">
          <i class="bi bi-person-badge text-primary"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body d-flex align-items-start justify-content-between">
        <div>
          <div class="text-muted small">Statut du compte</div>
          <div class="fw-bold">
            {% if app.user and attribute(app.user, 'active') is defined %}
              {{ app.user.active ? 'Actif' : 'Désactivé' }}
            {% else %}
              Actif
            {% endif %}
          </div>
          <div class="small text-muted">Activation / désactivation</div>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center"
             style="width:44px;height:44px;background:#fff7ed;">
          <i class="bi bi-shield-check text-warning"></i>
        </div>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════
   Section Offres (Mohamed)
   ══════════════════════════════════════════════════════ #}

<hr class="my-4">
<h4 class="mb-3">♻️ Espace Appels d'offres</h4>

{# Stats offres #}
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card text-center shadow-sm p-3">
      <div class="text-muted small">Réponses totales</div>
      <div class="fs-3 fw-bold text-success">{{ declarations|length }}</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-center shadow-sm p-3">
      <div class="text-muted small">Validées</div>
      <div class="fs-3 fw-bold text-success">{{ declarations|filter(d => d.status == 'valide')|length }}</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-center shadow-sm p-3">
      <div class="text-muted small">En attente</div>
      <div class="fs-3 fw-bold text-warning">{{ declarations|filter(d => d.status != 'valide')|length }}</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-center shadow-sm p-3">
      <div class="text-muted small">Éco points</div>
      <div class="fs-3 fw-bold text-success">{{ eco_points }}</div>
    </div>
  </div>
</div>

{# Actions — Espace Citoyen uniquement pour valorisateur #}
<div class="row g-3 mb-4">

</div>

{# Dernières réponses #}
<div class="card shadow-sm p-4">
  <h5 class="fw-bold mb-3">Dernières réponses</h5>
  <table class="table table-hover">
    <thead class="table-light">
      <tr>
        <th>Date</th>
        <th>Offre</th>
        <th>Quantité</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody>
      {% for item in declarations %}
        <tr>
          <td>{{ item.date }}</td>
          <td>{{ item.type }}</td>
          <td>{{ item.quantite }}</td>
          <td>
            <span class="badge {{ item.status == 'valide' ? 'bg-success' : 'bg-warning text-dark' }}">
              {{ item.status }}
            </span>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="text-center text-muted">Aucune réponse disponible.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endblock %}
