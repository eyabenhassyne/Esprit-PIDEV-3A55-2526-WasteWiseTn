{% extends 'valorisateur/base_valorizateur.html.twig' %}

{% block title %}Dashboard Valorisateur | WasteWise TN{% endblock %}

{% block body %}

  {# ===== HEADER PAGE ===== #}
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
    <div>
      <h3 class="mb-1">🏭 Dashboard Valorisateur</h3>
      <div class="text-muted">Espace utilisateur (module gestion du compte)</div>
    </div>

    {# ✅ Liens sûrs (profil) #}
    {% set base = app.request.baseUrl %}
    {% set urlProfil = base ~ '/valorisateur/profil' %}
    {% set urlProfilEdit = base ~ '/valorisateur/profil/modifier' %}

    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="{{ urlProfil }}">
        <i class="bi bi-person"></i> Mon profil
      </a>
      <a class="btn btn-success" href="{{ urlProfilEdit }}">
        <i class="bi bi-pencil"></i> Modifier
      </a>
    </div>
  </div>

  {# ===== INFOS COMPTE ===== #}
  <div class="row g-3 mb-3">

    <div class="col-12 col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Email</div>
            <div class="fw-bold">{{ app.user ? app.user.userIdentifier : '—' }}</div>
            <div class="small text-muted">Identifiant de connexion</div>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:#ecfdf5;border:1px solid rgba(0,0,0,.06);">
            <i class="bi bi-envelope text-success"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Type</div>
            <div class="fw-bold">
              {% if app.user and attribute(app.user, 'type') is defined %}
                {{ app.user.type }}
              {% else %}
                VALORIZER
              {% endif %}
            </div>
            <div class="small text-muted">Profil actuel</div>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:#eff6ff;border:1px solid rgba(0,0,0,.06);">
            <i class="bi bi-person-badge text-primary"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Statut du compte</div>
            <div class="fw-bold">
              {% if app.user and attribute(app.user, 'active') is defined %}
                {{ app.user.active ? 'Actif' : 'Désactivé' }}
              {% elseif app.user and attribute(app.user, 'isActive') is defined %}
                {{ app.user.isActive ? 'Actif' : 'Désactivé' }}
              {% else %}
                Actif
              {% endif %}
            </div>
            <div class="small text-muted">Activation / désactivation</div>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:#fff7ed;border:1px solid rgba(0,0,0,.06);">
            <i class="bi bi-shield-check text-warning"></i>
          </div>
        </div>
      </div>
    </div>

  </div>

  {# ===== PROFIL DETAILS ===== #}
  <div class="card shadow-sm">
    <div class="card-header fw-bold d-flex align-items-center justify-content-between flex-wrap gap-2">
      <span>Informations du profil</span>
      <span class="small text-muted">Lecture seule</span>
    </div>

    <div class="card-body">
      <div class="row g-3">

        <div class="col-12 col-md-4">
          <div class="text-muted small">Nom</div>
          <div class="fw-semibold">
            {% if app.user and attribute(app.user, 'nom') is defined %}
              {{ app.user.nom ?? '—' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="text-muted small">Prénom</div>
          <div class="fw-semibold">
            {% if app.user and attribute(app.user, 'prenom') is defined %}
              {{ app.user.prenom ?? '—' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="text-muted small">Téléphone</div>
          <div class="fw-semibold">
            {% if app.user and attribute(app.user, 'telephone') is defined %}
              {{ app.user.telephone ?? '—' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>

      </div>

      <hr class="my-3">

      <div class="text-muted small">
        ✅ Les modules “Déchets / Historique / Appels d’offres” ont été retirés. Ce dashboard est maintenant centré sur la gestion du compte utilisateur.
      </div>
    </div>
  </div>

{% endblock %}