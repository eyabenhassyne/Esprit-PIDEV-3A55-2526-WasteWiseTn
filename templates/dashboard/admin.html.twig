{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard Admin | WasteWise{% endblock %}
{% block page_title %}Admin{% endblock %}

{% block sidebar %}
  {% include 'admin/_sidebar.html.twig' %}
{% endblock %}

{% block body %}

  {# ===== HERO ===== #}
  <div class="hero d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
    <div>
      <h2 class="mb-1">Bienvenue Admin 👋</h2>
      <div class="opacity-75">
        Gestion des utilisateurs (module User)
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-light" href="{{ path('app_user_index') }}">
        <i class="fa-solid fa-users me-2"></i> Utilisateurs
      </a>
    </div>
  </div>

  {# ===== KPIs USERS ===== #}
  <div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Utilisateurs</div>
            <div class="fs-2 fw-bold">{{ usersTotal|default('—') }}</div>
            <div class="text-muted small">Comptes au total</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(47,107,79,.12);color:#2f6b4f;">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
        <div class="mt-3">
          <a class="btn btn-sm btn-outline-success w-100" href="{{ path('app_user_index') }}">
            Gérer <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Date</div>
            <div class="fs-4 fw-bold">{{ "now"|date("d/m/Y") }}</div>
            <div class="text-muted small">Aujourd'hui</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(141,210,47,.18);color:#2f6b4f;">
            <i class="fa-solid fa-calendar-day"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Compte</div>
            <div class="fs-6 fw-bold">{{ app.user ? app.user.userIdentifier : '—' }}</div>
            <div class="text-muted small">Administrateur connecté</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(59,130,246,.12);color:#2563eb;">
            <i class="fa-solid fa-user-shield"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ===== CONTENU ORIGINAL ===== #}
  <div class="row g-4 mb-4">
    <div class="col-12 col-lg-7">
      <div class="big-card h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h5 class="mb-0">📌 Derniers utilisateurs inscrits</h5>
          <span class="badge bg-light text-dark border">{{ "now"|date("d/m/Y") }}</span>
        </div>
        <table class="table table-sm table-hover">
          <thead class="table-light">
            <tr><th>Email</th><th>Rôle</th><th>Inscrit le</th></tr>
          </thead>
          <tbody>
            {% for user in lastUsers %}
              <tr>
                <td>{{ user.email }}</td>
                <td><span class="badge bg-secondary">{{ user.type }}</span></td>
                <td>{{ user.createdAt|date('d/m/Y') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  {# ══════════════════════════════════════════════════════
     Section Mohamed — KPIs offres + alertes + stats
     ══════════════════════════════════════════════════════ #}

  <hr class="my-4">
  <h5 class="mb-3">📦 Pilotage des appels d'offres</h5>

  {# KPIs offres #}
  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
      <div class="stat-card text-center">
        <div class="text-muted small">Appels actifs</div>
        <div class="fs-2 fw-bold" style="color:#2f6b4f;">{{ kpis.offres_actives }}</div>
        <div class="text-muted small">sur {{ kpis.total_appels }} appels</div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="stat-card text-center">
        <div class="text-muted small">Expirent sous 7j</div>
        <div class="fs-2 fw-bold text-warning">{{ kpis.offres_expirent_bientot }}</div>
        <div class="text-muted small">{{ kpis.offres_expirees }} déjà expirées</div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="stat-card text-center">
        <div class="text-muted small">Réponses (7j)</div>
        <div class="fs-2 fw-bold" style="color:#2f6b4f;">{{ kpis.reponses_last7 }}</div>
        <div class="small {{ kpis.trend_reponses_pct >= 0 ? 'text-success' : 'text-danger' }}">
          {{ kpis.trend_reponses_pct >= 0 ? '+' : '' }}{{ kpis.trend_reponses_pct }}% vs préc.
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="stat-card text-center">
        <div class="text-muted small">Taux validation</div>
        <div class="fs-2 fw-bold" style="color:#2f6b4f;">{{ kpis.taux_validation }}%</div>
        <div class="text-muted small">Indice santé : {{ kpis.health_index }}/100</div>
      </div>
    </div>
  </div>

  {# Centre d'alertes #}
  <div class="big-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="mb-0">🔔 Centre d'alertes</h5>
      <small class="text-muted">
        {{ alert_center.summary.total }} alerte(s) —
        {{ alert_center.summary.critical }} critique(s),
        {{ alert_center.summary.warning }} attention(s)
      </small>
    </div>
    {% for alert in alert_center.alerts %}
      <div class="p-3 mb-2 rounded-3 border-start border-4
        {{ alert.level == 'critical' ? 'border-danger bg-danger bg-opacity-10' :
           (alert.level == 'warning' ? 'border-warning bg-warning bg-opacity-10' : 'border-info bg-info bg-opacity-10') }}">
        <div class="d-flex justify-content-between align-items-center">
          <strong>{{ alert.title }}</strong>
          <span class="badge bg-secondary">{{ alert.metric }}</span>
        </div>
        <p class="mb-1 small text-muted">{{ alert.message }}</p>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path(alert.route, alert.route_params) }}">{{ alert.action_label }}</a>
      </div>
    {% endfor %}
  </div>

  {# Distribution statuts + Appels récents #}
  <div class="row g-4 mb-4">
    <div class="col-12 col-lg-5">
      <div class="big-card h-100">
        <h5 class="mb-3">📊 Distribution des statuts</h5>
        {% set total = status_distribution.validees + status_distribution.en_attente + status_distribution.refusees %}
        {% set total = total > 0 ? total : 1 %}
        <div class="mb-3">
          <div class="d-flex justify-content-between small mb-1"><span>Validées</span><strong>{{ status_distribution.validees }}</strong></div>
          <div class="progress" style="height:10px;"><div class="progress-bar bg-success" style="width:{{ (status_distribution.validees * 100 / total)|round }}%"></div></div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between small mb-1"><span>En attente</span><strong>{{ status_distribution.en_attente }}</strong></div>
          <div class="progress" style="height:10px;"><div class="progress-bar bg-warning" style="width:{{ (status_distribution.en_attente * 100 / total)|round }}%"></div></div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between small mb-1"><span>Refusées</span><strong>{{ status_distribution.refusees }}</strong></div>
          <div class="progress" style="height:10px;"><div class="progress-bar bg-danger" style="width:{{ (status_distribution.refusees * 100 / total)|round }}%"></div></div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-7">
      <div class="big-card h-100">
        <h5 class="mb-3">📋 Appels d'offre récents</h5>
        <table class="table table-sm table-hover">
          <thead class="table-light">
            <tr><th>Titre</th><th>Quantité</th><th>Date limite</th><th>État</th></tr>
          </thead>
          <tbody>
            {% for offre in recent_appels %}
              <tr>
                <td>{{ offre.titre }}</td>
                <td>{{ offre.quantite }}</td>
                <td>{{ offre.date_limite }}</td>
                <td><span class="badge {{ offre.est_expire ? 'bg-danger' : 'bg-success' }}">{{ offre.est_expire ? 'Expiré' : 'Actif' }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <a class="btn btn-sm btn-outline-success" href="{{ path('app_appel_offre_index') }}">Gérer les appels d'offre</a>
      </div>
    </div>
  </div>

  {# Réponses récentes #}
  <div class="big-card mb-4">
    <h5 class="mb-3">💬 Réponses récentes</h5>
    <table class="table table-sm table-hover">
      <thead class="table-light">
        <tr><th>Citoyen</th><th>Offre</th><th>Statut</th></tr>
      </thead>
      <tbody>
        {% for reponse in recent_reponses %}
          <tr>
            <td>{{ reponse.citoyen }}</td>
            <td>{{ reponse.offre }}</td>
            <td>
              <span class="badge {{ reponse.statut == 'valide' ? 'bg-success' : (reponse.statut == 'en attente' ? 'bg-warning text-dark' : 'bg-danger') }}">
                {{ reponse.statut|capitalize }}
              </span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <a class="btn btn-sm btn-outline-success" href="{{ path('app_reponse_offre_moderation') }}">Gérer les réponses</a>
  </div>

{% endblock %}
