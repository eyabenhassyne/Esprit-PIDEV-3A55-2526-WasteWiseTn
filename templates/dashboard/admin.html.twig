{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard Admin | WasteWise{% endblock %}
{% block page_title %}Admin{% endblock %}

{% block sidebar %}
  {% include 'admin/_sidebar.html.twig' %}
{% endblock %}

{% block body %}

  {# ===== HERO ===== #}
  <div class="hero d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
    <div>
      <h2 class="mb-1">Bienvenue Admin 👋</h2>
      <div class="opacity-75">
        Gestion des utilisateurs (module User)
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-light" href="{{ path('app_user_index') }}">
        <i class="fa-solid fa-users me-2"></i> Utilisateurs
      </a>

      {# Optionnel : si tu as une route create user #}
      {# 
      <a class="btn btn-light" href="{{ path('app_user_new') }}">
        <i class="fa-solid fa-user-plus me-2"></i> Nouveau
      </a>
      #}
    </div>
  </div>

  {# ===== KPIs ===== #}
  <div class="row g-4 mb-4">

    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Utilisateurs</div>
            <div class="fs-2 fw-bold">{{ usersTotal|default(usersCount|default('—')) }}</div>
            <div class="text-muted small">Comptes au total</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(47,107,79,.12);color:#2f6b4f;">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
        <div class="mt-3">
          <a class="btn btn-sm btn-outline-success w-100" href="{{ path('app_user_index') }}">
            Gérer <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Date</div>
            <div class="fs-4 fw-bold">{{ "now"|date("d/m/Y") }}</div>
            <div class="text-muted small">Aujourd’hui</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(141,210,47,.18);color:#2f6b4f;">
            <i class="fa-solid fa-calendar-day"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Compte</div>
            <div class="fs-6 fw-bold">{{ app.user ? app.user.userIdentifier : '—' }}</div>
            <div class="text-muted small">Administrateur connecté</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(59,130,246,.12);color:#2563eb;">
            <i class="fa-solid fa-user-shield"></i>
          </div>
        </div>
      </div>
    </div>

  </div>

  {# ===== CONTENU ===== #}
  <div class="row g-4">
    <div class="col-12 col-lg-7">
      <div class="big-card h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h5 class="mb-0">📌 Vue rapide</h5>
          <span class="badge bg-light text-dark border">
            {{ "now"|date("d/m/Y") }}
          </span>
        </div>

        <p class="text-muted mb-0">
          Ici tu peux afficher des statistiques liées aux utilisateurs (actifs/inactifs, derniers inscrits, rôles, etc.).
        </p>

        <hr class="my-3">

        <div class="row g-3">
          <div class="col-md-6">
            <div class="p-3 rounded-4 border bg-light">
              <div class="fw-semibold mb-1">✅ Idée</div>
              <div class="text-muted small">
                Derniers utilisateurs inscrits
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded-4 border bg-light">
              <div class="fw-semibold mb-1">💡 Idée</div>
              <div class="text-muted small">
                Répartition par rôle (Admin / Valorisateur / Citoyen)
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="big-card h-100">
        <h5 class="mb-3">⚡ Raccourcis</h5>

        <div class="d-grid gap-2">
          <a class="btn btn-outline-success" href="{{ path('app_user_index') }}">
            <i class="fa-solid fa-users me-2"></i> Gérer les utilisateurs
          </a>

          {# Optionnel : activer seulement si la route existe #}
          {# 
          <a class="btn btn-outline-success" href="{{ path('app_user_new') }}">
            <i class="fa-solid fa-user-plus me-2"></i> Créer un utilisateur
          </a>
          #}

          <a class="btn btn-outline-danger" href="{{ path('app_logout') }}">
            <i class="fa-solid fa-right-from-bracket me-2"></i> Déconnexion
          </a>
        </div>

        <hr class="my-3">

        <div class="text-muted small">
          Astuce : garde ce bloc pour les actions les plus fréquentes.
        </div>
      </div>
    </div>
  </div>

{% endblock %}