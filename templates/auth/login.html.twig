{% extends 'auth/base_auth.html.twig' %}

{% block title %}Connexion | WasteWise TN{% endblock %}

{% block stylesheets %}
<style>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: #f0f7f4;
    min-height: 100vh;
  }

  .login-wrapper {
    display: flex;
    min-height: 100vh;
  }

  /* ── Left panel ── */
  .login-left {
    flex: 1;
    background: linear-gradient(145deg, #0d4f3c 0%, #1a7a56 50%, #22c55e 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 48px;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .login-left::before {
    content: '';
    position: absolute;
    width: 420px; height: 420px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    top: -120px; right: -120px;
  }
  .login-left::after {
    content: '';
    position: absolute;
    width: 280px; height: 280px;
    border-radius: 50%;
    background: rgba(255,255,255,.05);
    bottom: -80px; left: -80px;
  }
  .login-left-inner { position: relative; z-index: 1; text-align: center; max-width: 420px; }
  .login-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
  }
  .login-brand-icon {
    width: 48px; height: 48px;
    background: rgba(255,255,255,.18);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
  }
  .login-brand-name { font-size: 1.4rem; font-weight: 800; letter-spacing: -.3px; }
  .login-left h2 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .login-left p {
    font-size: 1rem;
    opacity: .85;
    margin: 0 0 40px;
  }
  .login-illustration {
    width: 100%;
    max-width: 340px;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,.2));
  }
  .login-features {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 40px;
    text-align: left;
    width: 100%;
  }
  .login-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 12px;
    padding: 12px 16px;
    font-size: .9rem;
  }
  .login-feature i { font-size: 1.1rem; opacity: .9; }

  /* ── Right panel ── */
  .login-right {
    width: 480px;
    flex-shrink: 0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 40px;
    box-shadow: -8px 0 40px rgba(0,0,0,.06);
  }
  .login-form-wrap { width: 100%; max-width: 380px; }

  .login-title { font-size: 1.65rem; font-weight: 800; color: #0d2e1f; margin: 0 0 6px; }
  .login-subtitle { color: #64748b; font-size: .93rem; margin: 0 0 28px; }

  /* Social buttons */
  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 11px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: .9rem;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #1e293b;
    transition: background .18s, border-color .18s, box-shadow .18s;
    margin-bottom: 10px;
  }
  .social-btn:hover { background: #f8fafc; border-color: #cbd5e1; box-shadow: 0 2px 8px rgba(0,0,0,.06); color: #1e293b; }
  .social-btn--google i { color: #ea4335; }
  .social-btn--facebook { background: #1877f2; color: #fff; border-color: #1877f2; }
  .social-btn--facebook:hover { background: #1565d8; border-color: #1565d8; color: #fff; }
  .social-btn--github { background: #24292e; color: #fff; border-color: #24292e; }
  .social-btn--github:hover { background: #1a1e22; border-color: #1a1e22; color: #fff; }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
    color: #94a3b8;
    font-size: .82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  /* Form fields */
  .field-label {
    display: block;
    font-size: .8rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .field-input {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: .93rem;
    font-family: inherit;
    color: #1e293b;
    background: #f8fafc;
    transition: border-color .18s, background .18s, box-shadow .18s;
    outline: none;
  }
  .field-input:focus {
    border-color: #16a34a;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(22,163,74,.12);
  }
  .field-input::placeholder { color: #94a3b8; }

  .field-group { margin-bottom: 18px; }

  .field-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }
  .remember-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: .85rem;
    color: #475569;
    cursor: pointer;
  }
  .remember-label input[type="checkbox"] {
    width: 16px; height: 16px;
    accent-color: #16a34a;
    cursor: pointer;
  }
  .forgot-link {
    font-size: .85rem;
    color: #16a34a;
    text-decoration: none;
    font-weight: 600;
  }
  .forgot-link:hover { text-decoration: underline; }

  .btn-login {
    width: 100%;
    padding: 13px;
    background: linear-gradient(135deg, #16a34a, #0d7a38);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: .97rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: opacity .18s, transform .12s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .btn-login:hover { opacity: .92; transform: translateY(-1px); }
  .btn-login:active { transform: translateY(0); }

  .btn-face {
    width: 100%;
    padding: 11px;
    background: #f1f5f9;
    color: #334155;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: .9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    transition: background .18s, border-color .18s;
  }
  .btn-face:hover { background: #e2e8f0; border-color: #cbd5e1; color: #1e293b; }

  .register-link {
    text-align: center;
    margin-top: 22px;
    font-size: .88rem;
    color: #64748b;
  }
  .register-link a { color: #16a34a; font-weight: 700; text-decoration: none; }
  .register-link a:hover { text-decoration: underline; }

  /* Alert */
  .auth-alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: .88rem;
    margin-bottom: 18px;
  }
  .auth-alert--danger { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
  .auth-alert--success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .auth-alert--warning { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
  .auth-alert i { margin-top: 1px; flex-shrink: 0; }

  /* Responsive */
  @media (max-width: 900px) {
    .login-left { display: none; }
    .login-right { width: 100%; box-shadow: none; padding: 40px 24px; }
  }
</style>
{% endblock %}

{% block body %}
<div class="login-wrapper">

  {# ── Left panel ── #}
  <div class="login-left">
    <div class="login-left-inner">
      <div class="login-brand">
        <div class="login-brand-icon"><i class="fa-solid fa-leaf"></i></div>
        <span class="login-brand-name">WasteWise TN</span>
      </div>

      <h2>Bienvenue sur WasteWise TN</h2>
      <p>Déclare tes déchets et gagne des EcoPoints 🌿</p>

      <img src="{{ asset('assets/images/element/02.svg') }}"
           class="login-illustration"
           alt="WasteWise Illustration"
           onerror="this.style.display='none'">

      <div class="login-features">
        <div class="login-feature">
          <i class="fa-solid fa-recycle"></i>
          <span>Déclare tes déchets facilement</span>
        </div>
        <div class="login-feature">
          <i class="fa-solid fa-star"></i>
          <span>Gagne des EcoPoints à chaque déclaration</span>
        </div>
        <div class="login-feature">
          <i class="fa-solid fa-earth-africa"></i>
          <span>Contribue à un environnement plus propre</span>
        </div>
      </div>
    </div>
  </div>

  {# ── Right panel ── #}
  <div class="login-right">
    <div class="login-form-wrap">

      <h1 class="login-title">Connexion</h1>
      <p class="login-subtitle">Connecte-toi à ton compte</p>

      {# Flash messages #}
      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="auth-alert auth-alert--{{ label == 'error' ? 'danger' : label }}">
            <i class="fa-solid fa-circle-info"></i>
            <span>{{ message }}</span>
          </div>
        {% endfor %}
      {% endfor %}

      {# Auth error #}
      {% if error %}
        <div class="auth-alert auth-alert--danger">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
      {% endif %}

      {# Social login #}
      <a class="social-btn social-btn--google" href="{{ path('connect_google_start') }}">
        <i class="fab fa-google"></i> Continuer avec Google
      </a>
      <a class="social-btn social-btn--facebook" href="{{ path('connect_facebook_start') }}">
        <i class="fab fa-facebook"></i> Continuer avec Facebook
      </a>
      <a class="social-btn social-btn--github" href="{{ path('connect_github_start') }}">
        <i class="fab fa-github"></i> Continuer avec GitHub
      </a>

      <div class="divider">ou</div>

      {# Login form #}
      <form method="post" novalidate>

        <div class="field-group">
          <label class="field-label" for="email">Email</label>
          <input id="email"
                 type="email"
                 name="email"
                 value="{{ last_username }}"
                 class="field-input"
                 placeholder="ex: khalil@email.com"
                 autocomplete="email"
                 required>
        </div>

        <div class="field-group">
          <label class="field-label" for="password">Mot de passe</label>
          <input id="password"
                 type="password"
                 name="password"
                 class="field-input"
                 placeholder="••••••••"
                 autocomplete="current-password"
                 required>
        </div>

        <div class="field-row">
          <label class="remember-label">
            <input type="checkbox" name="_remember_me">
            Se souvenir de moi
          </label>
          <a class="forgot-link" href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn-login">
          <i class="fa-solid fa-arrow-right-to-bracket"></i>
          Connexion
        </button>
      </form>

      <a class="btn-face" href="{{ path('app_face_login') }}">
        <i class="fa-solid fa-camera"></i>
        Connexion avec visage
      </a>

      <div class="register-link">
        Pas de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
      </div>

    </div>
  </div>

</div>
{% endblock %}
