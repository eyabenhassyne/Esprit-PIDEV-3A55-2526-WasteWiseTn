{% extends 'citoyen/base.html.twig' %}

{% block title %}Mes déclarations | WasteWise TN{% endblock %}

{% block body %}

{# ── Page header ── #}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="ww-title mb-1"><i class="fa-solid fa-file-lines me-2" style="color:#2f6b4f;"></i>Mes déclarations</h2>
    <p class="ww-subtitle mb-0">Retrouvez toutes vos déclarations de déchets enregistrées</p>
  </div>
  <a href="{{ path('declaration_dechet_new') }}" class="btn btn-vert rounded-pill px-4">
    <i class="fa-solid fa-plus me-1"></i> Nouvelle déclaration
  </a>
</div>

{% if viewScope|default('mine') == 'all' %}
  <div class="alert alert-info rounded-3 shadow-sm mb-4">
    <i class="fa-solid fa-circle-info me-2"></i>
    Affichage global des déclarations (aucune déclaration personnelle trouvée pour ce compte).
  </div>
{% endif %}

{# ── Table card ── #}
<div class="ww-card">
  <div class="ww-card-h d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-clock-rotate-left me-2" style="color:#2f6b4f;"></i>Historique</span>
    {% if declarations is not empty %}
      <span class="badge rounded-pill" style="background:#e8f5e9;color:#2f6b4f;font-size:.8rem;">
        {{ declarations|length }} déclaration(s)
      </span>
    {% endif %}
  </div>
  <div class="ww-card-b p-0">

    {% if declarations is empty %}
      <div class="text-center py-5">
        <div style="font-size:3rem;margin-bottom:12px;">📋</div>
        <p class="text-muted mb-3">Aucune déclaration trouvée.</p>
        <a href="{{ path('declaration_dechet_new') }}" class="btn btn-vert rounded-pill px-4">
          <i class="fa-solid fa-plus me-1"></i> Faire ma première déclaration
        </a>
      </div>
    {% else %}
      <div class="table-responsive">
        <table class="table align-middle mb-0 decl-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Type</th>
              <th>Quantité</th>
              <th>Unité</th>
              <th>Date</th>
              <th>Score IA</th>
              <th>Points</th>
              <th>Statut</th>
              <th>QR Code</th>
            </tr>
          </thead>
          <tbody>
            {% for declaration in declarations %}
              <tr>
                <td><span class="text-muted small">#{{ declaration.id }}</span></td>
                <td>
                  <span class="fw-600">{{ declaration.typeDechet ? declaration.typeDechet.libelle : '—' }}</span>
                </td>
                <td>{{ declaration.quantite }}</td>
                <td><span class="badge bg-light text-dark">{{ declaration.unite }}</span></td>
                <td>
                  <span class="text-muted small">
                    {{ declaration.createdAt ? declaration.createdAt|date('d/m/Y') : '—' }}
                  </span>
                </td>
                <td>
                  {% if declaration.scoreIa is not null %}
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1" style="height:6px;border-radius:99px;min-width:60px;">
                        <div class="progress-bar bg-success" style="width:{{ (declaration.scoreIa * 100)|round }}%"></div>
                      </div>
                      <small>{{ (declaration.scoreIa * 100)|number_format(0) }}%</small>
                    </div>
                  {% else %}
                    <span class="text-muted">—</span>
                  {% endif %}
                </td>
                <td>
                  <span class="fw-700" style="color:#2f6b4f;">{{ declaration.pointsAttribues ?? 0 }}</span>
                  <small class="text-muted">pts</small>
                </td>
                <td>
                  {% if declaration.statut == 'APPROUVEE' %}
                    <span class="status-badge status-success"><i class="fa-solid fa-circle-check me-1"></i>Approuvée</span>
                  {% elseif declaration.statut == 'EN_ATTENTE' %}
                    <span class="status-badge status-warning"><i class="fa-solid fa-clock me-1"></i>En attente</span>
                  {% elseif declaration.statut == 'REFUSEE' %}
                    <span class="status-badge status-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Refusée</span>
                  {% else %}
                    <span class="status-badge status-secondary">{{ declaration.statut }}</span>
                  {% endif %}
                </td>
                <td>
                  {% if declaration.qrCode %}
                    <a href="{{ declaration.qrCode }}" target="_blank" rel="noopener noreferrer">
                      <img src="{{ declaration.qrCode }}" alt="QR #{{ declaration.id }}"
                           style="width:52px;height:52px;border-radius:8px;border:1px solid #e5e7eb;">
                    </a>
                  {% else %}
                    <span class="text-muted small">—</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {# ── Pagination ── #}
      {% set currentPage = pagination.page|default(1) %}
      {% set totalPages  = pagination.pages|default(1) %}
      {% if totalPages > 1 %}
        <div class="px-4 py-3 border-top d-flex justify-content-between align-items-center">
          <small class="text-muted">Page {{ currentPage }} / {{ totalPages }}</small>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                <a class="page-link rounded-start-pill" href="{{ path('citoyen_declarations', {page: currentPage - 1}) }}">
                  <i class="fa-solid fa-chevron-left"></i>
                </a>
              </li>
              <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                <a class="page-link rounded-end-pill" href="{{ path('citoyen_declarations', {page: currentPage + 1}) }}">
                  <i class="fa-solid fa-chevron-right"></i>
                </a>
              </li>
            </ul>
          </nav>
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>

<style>
.fw-600 { font-weight: 600; }
.fw-700 { font-weight: 700; }
.decl-table thead th {
  background: #f9fafb;
  font-size: .78rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  color: #6b7280;
  font-weight: 600;
  border-bottom: 1px solid #e5e7eb;
  padding: 12px 16px;
}
.decl-table tbody td { padding: 14px 16px; border-bottom: 1px solid #f3f4f6; }
.decl-table tbody tr:last-child td { border-bottom: none; }
.decl-table tbody tr:hover { background: #f9fafb; }

.status-badge {
  display: inline-flex; align-items: center;
  padding: 4px 10px; border-radius: 999px;
  font-size: .78rem; font-weight: 600;
}
.status-success  { background: #dcfce7; color: #16a34a; }
.status-warning  { background: #fef9c3; color: #ca8a04; }
.status-danger   { background: #fee2e2; color: #dc2626; }
.status-secondary{ background: #f3f4f6; color: #6b7280; }
</style>

{% endblock %}
