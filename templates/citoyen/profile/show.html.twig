{% extends 'citoyen/base.html.twig' %}

{% block title %}Mon profil | WasteWise TN{% endblock %}

{% block body %}

{# ── Page header ── #}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="ww-title mb-1"><i class="fa-solid fa-user me-2" style="color:#2f6b4f;"></i>Mon profil</h2>
    <p class="ww-subtitle mb-0">Consultez et mettez à jour vos informations personnelles</p>
  </div>
  <a class="btn btn-vert rounded-pill px-4" href="{{ path('citoyen_profile_edit') }}">
    <i class="bi bi-pencil-square me-1"></i> Modifier
  </a>
</div>

{# ── Flash messages ── #}
{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show rounded-3 shadow-sm" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}
{% endfor %}

{# ── Profile hero card ── #}
<div class="ww-card mb-4">
  <div class="ww-card-b">
    <div class="d-flex align-items-center gap-4 flex-wrap">
      <div class="profile-avatar">
        {{ (user.prenom ?? user.userIdentifier)|first|upper }}
      </div>
      <div>
        <h4 class="mb-1 fw-800" style="color:#0f2d1e;">
          {{ user.prenom ?? '' }} {{ user.nom ?? '' }}
        </h4>
        <div class="text-muted mb-2">{{ user.email ?? user.userIdentifier }}</div>
        <span class="role-badge">
          <i class="fa-solid fa-leaf"></i>
          {% set t = user.type ?? 'CITIZEN' %}
          {{ t == 'ADMIN' ? 'Administrateur' : (t == 'VALORIZER' ? 'Valorisateur' : 'Citoyen') }}
        </span>
      </div>
    </div>
  </div>
</div>

{# ── Info grid ── #}
<div class="ww-card">
  <div class="ww-card-h">
    <i class="fa-solid fa-circle-info me-2" style="color:#2f6b4f;"></i>Informations personnelles
  </div>
  <div class="ww-card-b">
    <div class="row g-4">

      <div class="col-md-6">
        <div class="info-item">
          <div class="info-label"><i class="fa-solid fa-id-card me-1"></i>Nom</div>
          <div class="info-value">{{ user.nom ?: '—' }}</div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="info-item">
          <div class="info-label"><i class="fa-solid fa-id-card me-1"></i>Prénom</div>
          <div class="info-value">{{ user.prenom ?: '—' }}</div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="info-item">
          <div class="info-label"><i class="fa-solid fa-phone me-1"></i>Téléphone</div>
          <div class="info-value">{{ user.telephone ?: '—' }}</div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="info-item">
          <div class="info-label"><i class="fa-solid fa-envelope me-1"></i>Email</div>
          <div class="info-value">{{ user.email ?? user.userIdentifier }}</div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="info-item">
          <div class="info-label"><i class="fa-solid fa-tag me-1"></i>Rôle</div>
          <div class="info-value">
            {% set t = user.type ?? 'CITIZEN' %}
            {{ t == 'ADMIN' ? 'Administrateur' : (t == 'VALORIZER' ? 'Valorisateur' : 'Citoyen') }}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{# ── Quick actions ── #}
<div class="row g-3 mt-2">
  <div class="col-md-4">
    <a href="{{ path('citoyen_profile_edit') }}" class="ww-action-tile">
      <div class="ww-action-icon" style="background:#dcfce7;color:#16a34a;">
        <i class="fa-solid fa-pen-to-square"></i>
      </div>
      <div>
        <div class="fw-600">Modifier le profil</div>
        <div class="small text-muted">Nom, email, téléphone</div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="{{ path('citoyen_face_enroll_page') }}" class="ww-action-tile">
      <div class="ww-action-icon" style="background:#dbeafe;color:#2563eb;">
        <i class="fa-solid fa-camera"></i>
      </div>
      <div>
        <div class="fw-600">Face ID</div>
        <div class="small text-muted">Enregistrer votre visage</div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="{{ path('citoyen_parametres') }}" class="ww-action-tile">
      <div class="ww-action-icon" style="background:#fef9c3;color:#ca8a04;">
        <i class="fa-solid fa-gear"></i>
      </div>
      <div>
        <div class="fw-600">Paramètres</div>
        <div class="small text-muted">Préférences du compte</div>
      </div>
    </a>
  </div>
</div>

<style>
.info-item { padding: 14px 18px; background: #f9fafb; border-radius: 12px; border: 1px solid rgba(0,0,0,.05); }
.info-label { font-size: .75rem; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
.info-value { font-weight: 600; color: #111827; font-size: .97rem; }
.ww-action-tile {
  display: flex; align-items: center; gap: 14px;
  background: #fff; border-radius: 16px; padding: 18px 20px;
  box-shadow: 0 4px 14px rgba(0,0,0,.06); border: 1px solid rgba(0,0,0,.04);
  text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s;
}
.ww-action-tile:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(0,0,0,.1); color: inherit; }
.ww-action-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
</style>

{% endblock %}
