<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Citoyen | WasteWise TN{% endblock %}</title>

  <link rel="shortcut icon" href="{{ asset('static/images/logo.png') }}" type="image/png">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root{
      --ww-bg:#f4f6f5;
      --ww-border:rgba(15,23,42,.08);
    }

    body{
      margin:0;
      font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:var(--ww-bg);
    }

    .main-wrapper{ display:flex; min-height:100vh; }

    .sidebar{
      width:260px;
      min-width:260px;
      flex-shrink:0;
      background:#0f2d1e;
      color:#fff;
      display:flex;
      flex-direction:column;
      overflow-y:auto;
      overflow-x:hidden;
    }
    .sidebar-menu{
      flex:1;
      overflow-y:auto;
    }
    .sidebar-footer{
      margin:12px;
      border-radius:14px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.1);
      padding:12px;
    }

    .side-brand{ font-weight:900; color:#fff; letter-spacing:-.3px; }
    .side-user{ display:flex; align-items:center; gap:10px; }
    .side-avatar{
      width:42px;
      height:42px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      background:rgba(255,255,255,.15);
      color:#fff;
      font-weight:bold;
    }

    /* New sidebar nav classes */
    .sb-section-title{
      color:rgba(255,255,255,.42);
      font-size:.7rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.1em;
      padding:18px 18px 6px;
      list-style:none;
      display:block;
    }
    .sb-link{
      display:flex;
      align-items:center;
      gap:12px;
      padding:11px 14px;
      margin:1px 10px;
      border-radius:10px;
      color:rgba(255,255,255,.75);
      text-decoration:none;
      font-size:.93rem;
      font-weight:500;
      transition:background .18s, color .18s;
    }
    .sb-link i{
      width:18px;
      text-align:center;
      font-size:.92rem;
      flex-shrink:0;
    }
    .sb-link:hover{
      background:rgba(255,255,255,.08);
      color:#fff;
    }
    .sb-link.sb-active{
      background:#7ed321;
      color:#0f2d1e;
      font-weight:700;
    }
    .sb-link.sb-active i{ color:#0f2d1e; }

    /* Keep old nav-link classes for logout */
    .sidebar .nav-link{
      border-radius:10px;
      padding:11px 14px;
      margin:1px 10px;
      display:flex;
      align-items:center;
      gap:12px;
      color:rgba(255,255,255,.75);
      transition:.18s;
      font-size:.93rem;
      font-weight:500;
      text-decoration:none;
    }
    .sidebar .nav-link i{
      width:18px;
      text-align:center;
      font-size:.92rem;
    }
    .sidebar .nav-link:hover{
      background:rgba(255,255,255,.08);
      color:#fff;
    }
    .sidebar .nav-link.active{
      background:#7ed321;
      color:#0f2d1e;
      font-weight:700;
    }
    .sidebar-section-title{
      color:rgba(255,255,255,.42);
      font-size:.7rem;
      text-transform:uppercase;
      letter-spacing:.1em;
      padding:18px 18px 6px;
    }
    .sidebar .nav-link.nav-link-logout{
      color:#ffa0a0;
    }
    .sidebar .nav-link.nav-link-logout:hover{
      background:rgba(255,80,80,.18);
      color:#fff;
    }

    .page-wrapper{ flex:1; background:var(--ww-bg); }

    .page-header{
      background:#fff;
      border-bottom:1px solid var(--ww-border);
    }

    @media (max-width: 991px){
      .main-wrapper{ flex-direction:column; }
      .sidebar{ width:100%; min-width:unset; }
    }
    .btn-vert{
      background:linear-gradient(135deg,#2f6b4f,#4a9e6e);
      color:#fff; border:none;
    }
    .btn-vert:hover, .btn-vert:focus{
      background:linear-gradient(135deg,#245840,#3a8a5c);
      color:#fff;
    }

    /* ── Page content helpers (match admin style) ── */
    .ww-title{
      font-size:1.45rem;
      font-weight:800;
      color:#0f2d1e;
      letter-spacing:-.3px;
    }
    .ww-subtitle{
      color:#6b7280;
      font-size:.9rem;
      margin-top:2px;
    }

    /* Cards */
    .ww-card{
      background:#fff;
      border-radius:18px;
      box-shadow:0 5px 20px rgba(0,0,0,.07);
      border:1px solid rgba(0,0,0,.04);
      margin-bottom:22px;
      overflow:hidden;
    }
    .ww-card-h{
      padding:16px 22px;
      font-weight:700;
      font-size:.95rem;
      color:#0f2d1e;
      border-bottom:1px solid rgba(0,0,0,.06);
      background:#f9fafb;
    }
    .ww-card-b{
      padding:22px;
    }

    /* Stat cards */
    .stat-card{
      background:#fff;
      border-radius:18px;
      padding:22px;
      box-shadow:0 5px 15px rgba(0,0,0,.07);
      border:1px solid rgba(0,0,0,.04);
      transition:.25s;
    }
    .stat-card:hover{ transform:translateY(-4px); }

    /* Hero banner */
    .hero{
      background:linear-gradient(90deg,#2f6b4f,#8bd22f);
      color:#fff;
      padding:34px;
      border-radius:20px;
      margin-bottom:22px;
      box-shadow:0 14px 40px rgba(0,0,0,.08);
    }

    /* Top header */
    .page-header{
      background:#fff;
      border-bottom:1px solid rgba(0,0,0,.07);
      padding:16px 26px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
    }
    .page-header .ph-title{
      font-weight:700;
      font-size:1rem;
      color:#0f2d1e;
    }
    .page-header .ph-sub{
      font-size:.78rem;
      color:#6b7280;
    }

    /* Info row inside ww-card */
    .info-label{
      font-size:.78rem;
      color:#6b7280;
      text-transform:uppercase;
      letter-spacing:.05em;
      margin-bottom:2px;
    }
    .info-value{
      font-weight:600;
      color:#111827;
      font-size:.97rem;
    }

    /* Badge pill */
    .role-badge{
      display:inline-flex;
      align-items:center;
      gap:6px;
      background:#e8f5e9;
      color:#2f6b4f;
      border-radius:20px;
      padding:4px 14px;
      font-size:.82rem;
      font-weight:700;
    }

    /* Avatar circle */
    .profile-avatar{
      width:72px;
      height:72px;
      border-radius:50%;
      background:linear-gradient(135deg,#2f6b4f,#7ed321);
      color:#fff;
      font-size:1.8rem;
      font-weight:800;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    /* Utilities */
    .fw-600{ font-weight:600; }
    .fw-700{ font-weight:700; }
    .fw-800{ font-weight:800; }
  </style>

  {% block stylesheets %}{% endblock %}
  {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

{% set route = app.request.attributes.get('_route') %}
{% set userLabel = app.user ? app.user.userIdentifier : 'Invite' %}
{% set firstChar = userLabel ? (userLabel|first|upper) : 'U' %}
{% set base = app.request.baseUrl %}
{% set urlProfilEdit = base ~ '/citoyen/profil/modifier' %}

<div class="main-wrapper">

  <aside class="sidebar" style="background:#0f2d1e;">

    <div class="p-3" style="border-bottom:1px solid rgba(255,255,255,.08);">
      <a href="{{ path('app_dashboard_citoyen') }}" class="d-flex align-items-center gap-2 text-decoration-none">
        <div style="width:34px;height:34px;background:rgba(255,255,255,.1);border-radius:9px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
          <img src="{{ asset('static/images/logo.png') }}" alt="WasteWise" style="width:26px;height:26px;object-fit:contain;">
        </div>
        <span class="side-brand">WasteWise TN</span>
      </a>
      <div class="small" style="color:rgba(255,255,255,.45); margin-top:2px;">Espace Citoyen</div>
    </div>

    <div class="p-3" style="border-bottom:1px solid rgba(255,255,255,.08);">
      <div class="side-user">
        <div class="side-avatar">{{ firstChar }}</div>
        <div class="min-w-0">
          <div class="fw-semibold text-truncate" style="color:#fff;">{{ userLabel }}</div>
          <div class="small" style="color:rgba(255,255,255,.45);">
            {{ (app.user and attribute(app.user, 'type') is defined) ? app.user.type : 'CITOYEN' }}
          </div>
        </div>
      </div>
    </div>

    <div class="py-2 sidebar-menu">
      <ul class="nav flex-column" style="list-style:none; padding:0; margin:0;">
        {% include 'partials/_sidebar_citoyen.html.twig' %}
      </ul>
    </div>

    <div class="sidebar-footer">
      <div class="fw-semibold text-truncate" style="color:#fff;">{{ userLabel }}</div>
      <div class="small mb-2" style="color:rgba(255,255,255,.45);">
        {{ (app.user and attribute(app.user, 'type') is defined) ? app.user.type : 'CITOYEN' }}
      </div>
      <a class="nav-link nav-link-logout mb-0 p-0" href="{{ path('app_logout') }}">
        <i class="fa-solid fa-right-from-bracket"></i>
        <span>Deconnexion</span>
      </a>
    </div>

  </aside>

  <div class="page-wrapper">

    <header class="page-header">
      <div>
        <div class="ph-title">{% block page_title %}Espace Citoyen{% endblock %}</div>
        <div class="ph-sub">WasteWise TN • Espace Citoyen</div>
      </div>
      {% if app.user %}
        <div class="d-flex align-items-center gap-3">
          <div class="text-end">
            <div class="fw-600" style="font-size:.9rem;color:#0f2d1e;">{{ app.user.userIdentifier }}</div>
            <div class="small text-muted">Citoyen</div>
          </div>
          <a href="{{ urlProfilEdit }}" class="btn btn-sm btn-outline-success rounded-pill px-3">
            <i class="bi bi-pencil"></i>
          </a>
        </div>
      {% endif %}
    </header>

    <main style="padding:26px;">
      {% block body %}{% endblock %}
    </main>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
