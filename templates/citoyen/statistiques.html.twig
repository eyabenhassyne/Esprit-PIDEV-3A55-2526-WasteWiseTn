{% extends 'citoyen/base.html.twig' %}

{% block title %}Mes statistiques | WasteWise TN{% endblock %}

{% block body %}

{# ── Page header ── #}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="ww-title mb-1"><i class="fa-solid fa-chart-line me-2" style="color:#2f6b4f;"></i>Mes statistiques EcoPoints</h2>
    <p class="ww-subtitle mb-0">Suivi des déclarations approuvées et des transactions de portefeuille</p>
  </div>
</div>

{% if viewScope|default('mine') == 'all' %}
  <div class="alert alert-info rounded-3 shadow-sm mb-4">
    <i class="fa-solid fa-circle-info me-2"></i>
    Affichage global des statistiques (aucune donnée personnelle trouvée pour ce compte).
  </div>
{% endif %}

{# ── KPI cards ── #}
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
        <i class="fa-solid fa-wallet"></i>
      </div>
      <div class="stat-label">Solde actuel</div>
      <div class="stat-value">{{ soldeActuel ?? (wallet ? wallet.soldeActuel : 0) }}</div>
      <div class="stat-unit">points</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
        <i class="fa-solid fa-arrow-trend-up"></i>
      </div>
      <div class="stat-label">Total gains</div>
      <div class="stat-value">{{ totalGains ?? 0 }}</div>
      <div class="stat-unit">points</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#fee2e2;color:#dc2626;">
        <i class="fa-solid fa-arrow-trend-down"></i>
      </div>
      <div class="stat-label">Total dépenses</div>
      <div class="stat-value">{{ totalDepenses ?? 0 }}</div>
      <div class="stat-unit">points</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#fef9c3;color:#ca8a04;">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div class="stat-label">Déclarations approuvées</div>
      <div class="stat-value">{{ totalApprouvees ?? 0 }}</div>
      <div class="stat-unit">déclarations</div>
    </div>
  </div>
</div>

{# ── Transactions table ── #}
<div class="ww-card">
  <div class="ww-card-h d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-receipt me-2" style="color:#2f6b4f;"></i>Historique des transactions</span>
    <span class="badge rounded-pill" style="background:#e8f5e9;color:#2f6b4f;font-size:.8rem;">
      {{ transactionsCount ?? 0 }} transaction(s)
    </span>
  </div>
  <div class="ww-card-b p-0">

    {% if transactions is empty %}
      <div class="text-center py-5">
        <div style="font-size:3rem;margin-bottom:12px;">💳</div>
        <p class="text-muted mb-0">Aucune transaction pour le moment.</p>
      </div>
    {% else %}
      <div class="table-responsive">
        <table class="table align-middle mb-0 stat-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Montant</th>
              <th>Motif</th>
            </tr>
          </thead>
          <tbody>
            {% for transaction in transactions %}
              <tr>
                <td>
                  <span class="text-muted small">
                    {{ transaction.dateTransaction ? transaction.dateTransaction|date('d/m/Y H:i') : '—' }}
                  </span>
                </td>
                <td>
                  {% if transaction.type == 'Gain' %}
                    <span class="status-badge status-success"><i class="fa-solid fa-plus me-1"></i>Gain</span>
                  {% else %}
                    <span class="status-badge status-danger"><i class="fa-solid fa-minus me-1"></i>Dépense</span>
                  {% endif %}
                </td>
                <td>
                  <span class="fw-700" style="color:{{ transaction.type == 'Gain' ? '#16a34a' : '#dc2626' }};">
                    {{ transaction.type == 'Gain' ? '+' : '-' }}{{ transaction.montant }}
                  </span>
                  <small class="text-muted">pts</small>
                </td>
                <td class="text-muted small">{{ transaction.motif }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

  </div>
</div>

<style>
.stat-card {
  background: #fff; border-radius: 18px; padding: 22px;
  box-shadow: 0 5px 15px rgba(0,0,0,.07); border: 1px solid rgba(0,0,0,.04);
  transition: transform .2s, box-shadow .2s;
}
.stat-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(0,0,0,.1); }
.stat-icon {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; margin-bottom: 12px;
}
.stat-label { font-size: .8rem; color: #6b7280; margin-bottom: 4px; }
.stat-value { font-size: 2rem; font-weight: 800; color: #0f2d1e; line-height: 1; }
.stat-unit  { font-size: .75rem; color: #9ca3af; margin-top: 2px; }

.stat-table thead th {
  background: #f9fafb; font-size: .78rem; text-transform: uppercase;
  letter-spacing: .05em; color: #6b7280; font-weight: 600;
  border-bottom: 1px solid #e5e7eb; padding: 12px 16px;
}
.stat-table tbody td { padding: 14px 16px; border-bottom: 1px solid #f3f4f6; }
.stat-table tbody tr:last-child td { border-bottom: none; }
.stat-table tbody tr:hover { background: #f9fafb; }

.fw-700 { font-weight: 700; }
.status-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: .78rem; font-weight: 600; }
.status-success { background: #dcfce7; color: #16a34a; }
.status-danger  { background: #fee2e2; color: #dc2626; }
</style>

{% endblock %}
