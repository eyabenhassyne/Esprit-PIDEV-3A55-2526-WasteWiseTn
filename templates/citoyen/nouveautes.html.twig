{% extends 'citoyen/base.html.twig' %}

{% block title %}Nouveautés | WasteWise TN{% endblock %}

{% block body %}

{# ── Page header ── #}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="ww-title mb-1"><i class="fa-solid fa-newspaper me-2" style="color:#2f6b4f;"></i>Actualités Pollution</h2>
    <p class="ww-subtitle mb-0">Actualités récentes sur la pollution et l'environnement</p>
  </div>
</div>

{% if not newsAvailable %}
  <div class="alert alert-warning rounded-3 shadow-sm mb-4">
    <i class="fa-solid fa-triangle-exclamation me-2"></i>
    {{ newsMessage ?: 'Nouveautés indisponibles pour le moment.' }}
  </div>
{% endif %}

{% if articles is empty %}
  <div class="ww-card">
    <div class="ww-card-b text-center py-5">
      <div style="font-size:3rem;margin-bottom:12px;">📰</div>
      <p class="text-muted mb-0">Aucun article disponible actuellement.</p>
    </div>
  </div>
{% else %}
  <div class="row g-4">
    {% for article in articles %}
      <div class="col-12 col-md-6 col-xl-4">
        <article class="news-card h-100">

          {% if article.image %}
            <div class="news-img-wrap">
              <img src="{{ article.image }}" alt="{{ article.title }}" class="news-img">
            </div>
          {% else %}
            <div class="news-img-placeholder">
              <i class="fa-solid fa-newspaper"></i>
            </div>
          {% endif %}

          <div class="news-body">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
              <span class="news-source">{{ article.source ?: 'Source' }}</span>
              <small class="text-muted">
                {% if article.publishedAt %}
                  {{ article.publishedAt|date('d/m/Y') }}
                {% else %}
                  —
                {% endif %}
              </small>
            </div>

            <h5 class="news-title">{{ article.title }}</h5>
            <p class="news-desc">{{ article.description ?: 'Aucune description disponible.' }}</p>

            {% if article.url %}
              <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-vert btn-sm rounded-pill px-3 mt-auto">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Lire l'article
              </a>
            {% endif %}
          </div>

        </article>
      </div>
    {% endfor %}
  </div>
{% endif %}

<style>
.news-card {
  background: #fff;
  border-radius: 18px;
  box-shadow: 0 5px 18px rgba(0,0,0,.07);
  border: 1px solid rgba(0,0,0,.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .2s, box-shadow .2s;
}
.news-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,.11); }

.news-img-wrap { height: 180px; overflow: hidden; }
.news-img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
.news-card:hover .news-img { transform: scale(1.04); }

.news-img-placeholder {
  height: 140px;
  background: linear-gradient(135deg, #e8f5e9, #f0fdf4);
  display: flex; align-items: center; justify-content: center;
  font-size: 2.5rem; color: #2f6b4f;
}

.news-body { padding: 18px 20px; display: flex; flex-direction: column; flex: 1; }

.news-source {
  background: #e8f5e9; color: #2f6b4f;
  border-radius: 999px; padding: 3px 10px;
  font-size: .75rem; font-weight: 700;
}

.news-title {
  font-size: .97rem; font-weight: 700; color: #0f2d1e;
  margin-bottom: 8px; line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.news-desc {
  font-size: .87rem; color: #6b7280; flex: 1; margin-bottom: 14px;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
</style>

{% endblock %}
