{% extends 'citoyen/base.html.twig' %}

{% block title %}Qualité de l'air | WasteWise TN{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
{% endblock %}

{% block body %}

{# ── Page header ── #}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h2 class="ww-title mb-1"><i class="fa-solid fa-wind me-2" style="color:#0f766e;"></i>Qualité de l'air & Pollution</h2>
    <p class="ww-subtitle mb-0">Stations de mesure en temps réel via OpenAQ</p>
  </div>
  <button type="button" id="reloadAqDataBtn" class="btn btn-vert rounded-pill px-4">
    <i class="fa-solid fa-rotate me-1"></i> Actualiser
  </button>
</div>

{# ── Legend row ── #}
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="aq-legend-card" style="border-left:4px solid #16a34a;">
      <div class="aq-legend-icon" style="background:#dcfce7;color:#16a34a;"><i class="fa-solid fa-circle-check"></i></div>
      <div class="aq-legend-label">Bon</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="aq-legend-card" style="border-left:4px solid #ca8a04;">
      <div class="aq-legend-icon" style="background:#fef9c3;color:#ca8a04;"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div class="aq-legend-label">Modéré</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="aq-legend-card" style="border-left:4px solid #ea580c;">
      <div class="aq-legend-icon" style="background:#ffedd5;color:#ea580c;"><i class="fa-solid fa-smog"></i></div>
      <div class="aq-legend-label">Mauvais</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="aq-legend-card" style="border-left:4px solid #dc2626;">
      <div class="aq-legend-icon" style="background:#fee2e2;color:#dc2626;"><i class="fa-solid fa-skull-crossbones"></i></div>
      <div class="aq-legend-label">Dangereux</div>
    </div>
  </div>
</div>

{# ── Map card ── #}
<div class="ww-card mb-4">
  <div class="ww-card-h d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-map-location-dot me-2" style="color:#0f766e;"></i>Carte des stations OpenAQ</span>
    <span class="text-muted small" id="aqStatusText">Chargement...</span>
  </div>
  <div class="ww-card-b p-0">
    <div id="aqMap" style="width:100%;height:500px;border-radius:0 0 18px 18px;"></div>
  </div>
</div>

{# ── Info card ── #}
<div class="ww-card">
  <div class="ww-card-h"><i class="fa-solid fa-circle-info me-2" style="color:#2563eb;"></i>Comment lire la carte ?</div>
  <div class="ww-card-b">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="aq-tip">
          <div class="aq-tip-icon"><i class="fa-solid fa-location-dot"></i></div>
          <div>
            <div class="fw-600 mb-1">Stations de mesure</div>
            <div class="text-muted small">Chaque point représente une station de mesure OpenAQ active.</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="aq-tip">
          <div class="aq-tip-icon"><i class="fa-solid fa-hand-pointer"></i></div>
          <div>
            <div class="fw-600 mb-1">Cliquez sur un marker</div>
            <div class="text-muted small">Voir les polluants suivis : PM2.5, NO2, O3, CO, etc.</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="aq-tip">
          <div class="aq-tip-icon"><i class="fa-solid fa-database"></i></div>
          <div>
            <div class="fw-600 mb-1">Source des données</div>
            <div class="text-muted small">Données chargées depuis l'API OpenAQ en temps réel.</div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-3 pt-3 border-top">
      <a href="https://explore.openaq.org/#1.83/22.13/30.18" target="_blank" rel="noopener noreferrer"
         class="btn btn-outline-secondary btn-sm rounded-pill px-4">
        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Ouvrir OpenAQ Explorer
      </a>
    </div>
  </div>
</div>

<style>
.aq-legend-card {
  background: #fff; border-radius: 14px; padding: 14px 16px;
  box-shadow: 0 4px 12px rgba(0,0,0,.06); border: 1px solid rgba(0,0,0,.04);
  display: flex; align-items: center; gap: 12px;
}
.aq-legend-icon {
  width: 38px; height: 38px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; flex-shrink: 0;
}
.aq-legend-label { font-weight: 600; font-size: .9rem; color: #374151; }

.aq-tip {
  display: flex; align-items: flex-start; gap: 14px;
  background: #f9fafb; border-radius: 12px; padding: 14px 16px;
  border: 1px solid rgba(0,0,0,.04);
}
.aq-tip-icon {
  width: 38px; height: 38px; border-radius: 10px;
  background: #e8f5e9; color: #2f6b4f;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; flex-shrink: 0;
}
.fw-600 { font-weight: 600; }
</style>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const map = L.map('aqMap').setView([{{ mapCenterLat }}, {{ mapCenterLng }}], 7);
  const statusEl = document.getElementById('aqStatusText');
  const reloadBtn = document.getElementById('reloadAqDataBtn');
  const markersLayer = L.layerGroup().addTo(map);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  function updateStatus(msg) { if (statusEl) statusEl.textContent = msg; }

  function buildPopup(station) {
    const params = Array.isArray(station.parameters) && station.parameters.length
      ? station.parameters.join(', ') : 'Non renseigné';
    return `<div style="font-weight:700;margin-bottom:4px;">${station.name || 'Station'}</div>
            <div><strong>Provider:</strong> ${station.provider || 'OpenAQ'}</div>
            <div><strong>Polluants:</strong> ${params}</div>`;
  }

  async function loadStations() {
    updateStatus('Chargement...');
    markersLayer.clearLayers();
    const markerPoints = [];
    try {
      const res  = await fetch('{{ path('citoyen_air_quality_data') }}', { headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!res.ok || !data.success) { updateStatus(data.message || 'Données indisponibles.'); return; }
      const stations = Array.isArray(data.stations) ? data.stations : [];
      if (!stations.length) { updateStatus('Aucune station disponible.'); return; }
      stations.forEach(s => {
        if (typeof s.latitude !== 'number' || typeof s.longitude !== 'number') return;
        L.circleMarker([s.latitude, s.longitude], {
          radius: 7, color: '#0f766e', fillColor: '#22c55e', fillOpacity: .75, weight: 1.5
        }).bindPopup(buildPopup(s)).addTo(markersLayer);
        markerPoints.push([s.latitude, s.longitude]);
      });
      if (markerPoints.length) map.fitBounds(L.latLngBounds(markerPoints).pad(.2));
      updateStatus(`${stations.length} station(s) affichée(s)`);
    } catch { updateStatus('Erreur réseau.'); }
  }

  reloadBtn?.addEventListener('click', loadStations);
  loadStations();
});
</script>

{% endblock %}
