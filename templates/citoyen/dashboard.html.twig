{% extends 'citoyen/base.html.twig' %}

{% block title %}WasteWise TN - Dashboard Citoyen{% endblock %}

{% block stylesheets %}
<style>
  /* ── Hero ── */
  .cit-hero {
    background: linear-gradient(130deg, #0d4f3c 0%, #1a7a56 55%, #22c55e 100%);
    color: #fff;
    border-radius: 22px;
    padding: 32px 36px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    box-shadow: 0 14px 40px rgba(0,0,0,.12);
  }
  .cit-hero h2 {
    margin: 0 0 6px;
    font-size: 1.65rem;
    font-weight: 800;
  }
  .cit-hero p {
    margin: 0 0 14px;
    opacity: .88;
    font-size: .97rem;
  }
  .cit-hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cit-pill {
    background: rgba(255,255,255,.92);
    color: #0d4f3c;
    border-radius: 999px;
    padding: 5px 14px;
    font-weight: 700;
    font-size: .82rem;
  }
  .cit-hero-stats {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .cit-hero-stat {
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.32);
    border-radius: 16px;
    padding: 12px 18px;
    text-align: center;
    min-width: 90px;
  }
  .cit-hero-stat span {
    display: block;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    opacity: .85;
  }
  .cit-hero-stat strong {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
    margin-top: 2px;
  }

  /* ── Cards ── */
  .cit-card {
    background: #fff;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 5px 18px rgba(0,0,0,.07);
    border: 1px solid rgba(0,0,0,.04);
    height: 100%;
  }
  .cit-card h5 {
    font-weight: 700;
    margin: 0 0 14px;
    font-size: 1rem;
    color: #1a3d2e;
  }

  /* ── Metric cards ── */
  .cit-metric {
    background: #fff;
    border-radius: 16px;
    padding: 18px 20px;
    box-shadow: 0 5px 18px rgba(0,0,0,.07);
    border: 1px solid rgba(0,0,0,.04);
    transition: transform .2s, box-shadow .2s;
    height: 100%;
  }
  .cit-metric:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0,0,0,.11);
  }
  .cit-metric-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .cit-metric-icon--teal  { background: #d0fdf4; color: #0f766e; }
  .cit-metric-icon--green { background: #dcfce7; color: #16a34a; }
  .cit-metric-icon--amber { background: #fef9c3; color: #ca8a04; }
  .cit-metric-icon--blue  { background: #dbeafe; color: #2563eb; }
  .cit-metric-label {
    display: block;
    font-size: .8rem;
    color: #64748b;
    margin-bottom: 4px;
  }
  .cit-metric-value {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1a3d2e;
    margin: 0;
    line-height: 1;
  }

  /* ── Weather ── */
  .cit-weather {
    background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
    border: 1px solid #bbf7d0;
    border-radius: 18px;
    padding: 22px 26px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .cit-weather-temp {
    font-size: 2.8rem;
    font-weight: 800;
    color: #166534;
    line-height: 1;
    margin: 6px 0 0;
  }
  .cit-weather-city {
    font-weight: 700;
    color: #166534;
    font-size: 1rem;
    margin: 0 0 4px;
  }
  .cit-weather-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    color: #374151;
    font-size: .88rem;
  }
  .cit-weather-meta i { color: #0f766e; }

  /* ── Chart cards ── */
  .cit-chart-card {
    border-top: 4px solid #22c55e;
  }
  .cit-chart-wrap {
    position: relative;
    height: 260px;
  }
  .cit-chart-wrap--lg {
    height: 300px;
  }

  /* ── Action cards ── */
  .cit-action-card {
    background: #fff;
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 5px 18px rgba(0,0,0,.07);
    border: 1px solid rgba(0,0,0,.04);
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .cit-action-card h4 {
    font-weight: 700;
    margin: 0 0 8px;
    color: #1a3d2e;
  }
  .cit-action-card p {
    color: #64748b;
    flex: 1;
    margin: 0 0 16px;
    font-size: .93rem;
  }
</style>
{% endblock %}

{% block body %}

{# ── Hero ── #}
<div class="cit-hero">
  <div>
    <h2><i class="fa-solid fa-leaf me-2"></i>Dashboard Citoyen</h2>
    <p>Suivez votre impact écologique avec des courbes dynamiques et vos indicateurs personnels.</p>
    <div class="cit-hero-pills">
      <span class="cit-pill"><i class="fa-solid fa-file-lines me-1"></i>Déclarations: {{ totalDeclarations ?? 0 }}</span>
      <span class="cit-pill"><i class="fa-solid fa-circle-check me-1"></i>Validées: {{ totalValidees ?? 0 }}</span>
      <span class="cit-pill"><i class="fa-solid fa-star me-1"></i>EcoPoints: {{ totalPoints ?? 0 }}</span>
    </div>
  </div>
  <div class="cit-hero-stats">
    <div class="cit-hero-stat">
      <span>Déclarations</span>
      <strong>{{ totalDeclarations ?? 0 }}</strong>
    </div>
    <div class="cit-hero-stat">
      <span>EcoPoints</span>
      <strong>{{ totalPoints ?? 0 }}</strong>
    </div>
  </div>
</div>

{# ── Météo ── #}
{% if weather is defined %}
<div class="cit-weather">
  {% if weather.available %}
    <div>
      <p class="cit-weather-city"><i class="fa-solid fa-cloud-sun me-2"></i>Météo actuelle — {{ weather.city }}</p>
      <div class="cit-weather-temp">{{ weather.temperature|default(0)|round }}&deg;C</div>
    </div>
    <div class="cit-weather-meta">
      <span><i class="fa-solid fa-wind me-1"></i>Vent: {{ weather.wind_speed|default(0) }} km/h</span>
      <span><i class="fa-solid fa-cloud me-1"></i>Code météo: {{ weather.weather_code|default('-') }}</span>
      <span><i class="fa-solid fa-clock me-1"></i>Màj: {{ weather.time|default('-') }}</span>
    </div>
  {% else %}
    <p class="mb-0" style="color:#374151;"><i class="fa-solid fa-circle-exclamation me-2" style="color:#0f766e;"></i>{{ weather.message|default('Météo indisponible') }}</p>
  {% endif %}
</div>
{% endif %}

{# ── KPI metrics ── #}
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="cit-metric">
      <div class="cit-metric-icon cit-metric-icon--teal"><i class="fa-solid fa-file-lines"></i></div>
      <span class="cit-metric-label">Déclarations totales</span>
      <h4 class="cit-metric-value">{{ totalDeclarations ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="cit-metric">
      <div class="cit-metric-icon cit-metric-icon--green"><i class="fa-solid fa-circle-check"></i></div>
      <span class="cit-metric-label">Validées</span>
      <h4 class="cit-metric-value">{{ totalValidees ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="cit-metric">
      <div class="cit-metric-icon cit-metric-icon--amber"><i class="fa-solid fa-clock"></i></div>
      <span class="cit-metric-label">En attente</span>
      <h4 class="cit-metric-value">{{ totalEnAttente ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="cit-metric">
      <div class="cit-metric-icon cit-metric-icon--blue"><i class="fa-solid fa-star"></i></div>
      <span class="cit-metric-label">Points gagnés</span>
      <h4 class="cit-metric-value">{{ totalPoints ?? 0 }}</h4>
    </div>
  </div>
</div>

{# ── Charts row 1 ── #}
<div class="row g-4 mb-4">
  <div class="col-12 col-xl-8">
    <div class="cit-card cit-chart-card">
      <h5><i class="fa-solid fa-chart-line me-2" style="color:#0f766e;"></i>Courbe des déclarations (6 derniers mois)</h5>
      <div class="cit-chart-wrap cit-chart-wrap--lg">
        <canvas id="declarationCurveChart"></canvas>
      </div>
    </div>
  </div>
  <div class="col-12 col-xl-4">
    <div class="cit-card cit-chart-card">
      <h5><i class="fa-solid fa-chart-pie me-2" style="color:#16a34a;"></i>Répartition des statuts</h5>
      <div class="cit-chart-wrap cit-chart-wrap--lg">
        <canvas id="statusDonutChart"></canvas>
      </div>
    </div>
  </div>
</div>

{# ── Charts row 2 ── #}
<div class="row g-4 mb-4">
  <div class="col-12 col-lg-6">
    <div class="cit-card cit-chart-card">
      <h5><i class="fa-solid fa-coins me-2" style="color:#ca8a04;"></i>Courbe des EcoPoints</h5>
      <div class="cit-chart-wrap">
        <canvas id="pointsCurveChart"></canvas>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="cit-card cit-chart-card">
      <h5><i class="fa-solid fa-weight-hanging me-2" style="color:#2563eb;"></i>Courbe kg déclarés</h5>
      <div class="cit-chart-wrap">
        <canvas id="kgCurveChart"></canvas>
      </div>
    </div>
  </div>
</div>

{# ── Action cards ── #}
<div class="row g-4">
  <div class="col-md-6">
    <div class="cit-action-card">
      <h4><i class="fa-solid fa-recycle me-2" style="color:#16a34a;"></i>Déclarer un déchet</h4>
      <p>Contribuez à l'environnement en déclarant vos déchets et gagnez des EcoPoints.</p>
      <a href="{{ path('declaration_dechet_new') }}" class="btn btn-success rounded-pill px-4 align-self-start">
        <i class="fa-solid fa-plus me-1"></i>Déclarer maintenant
      </a>
    </div>
  </div>
  <div class="col-md-6">
    <div class="cit-action-card">
      <h4><i class="fa-solid fa-chart-bar me-2" style="color:#0f766e;"></i>Suivre votre progression</h4>
      <p>Consultez vos transactions et vos statistiques EcoPoints détaillées.</p>
      <a href="{{ path('citoyen_statistiques') }}" class="btn btn-outline-success rounded-pill px-4 align-self-start">
        <i class="fa-solid fa-arrow-right me-1"></i>Voir statistiques
      </a>
    </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  const labels = {{ monthlyLabels|default([])|json_encode|raw }};
  const declarationData = {{ monthlyDeclarations|default([])|json_encode|raw }};
  const pointsData = {{ monthlyPoints|default([])|json_encode|raw }};
  const kgData = {{ monthlyKg|default([])|json_encode|raw }};
  const statusSplit = {{ statusSplit|default([0,0,0])|json_encode|raw }};

  const defaults = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } }
  };

  function mkLine(id, data, color) {
    const el = document.getElementById(id);
    if (!el) return;
    new Chart(el, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          data,
          borderColor: color,
          backgroundColor: color + '26',
          fill: true,
          tension: 0.38,
          pointRadius: 4,
          pointBackgroundColor: color
        }]
      },
      options: { ...defaults }
    });
  }

  mkLine('declarationCurveChart', declarationData, '#0f766e');
  mkLine('pointsCurveChart',      pointsData,      '#16a34a');
  mkLine('kgCurveChart',          kgData,          '#2563eb');

  const donutEl = document.getElementById('statusDonutChart');
  if (donutEl) {
    new Chart(donutEl, {
      type: 'doughnut',
      data: {
        labels: ['Approuvées', 'En attente', 'Refusées'],
        datasets: [{
          data: statusSplit,
          backgroundColor: ['#16a34a', '#f59e0b', '#ef4444'],
          borderWidth: 2,
          borderColor: '#fff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { padding: 16, font: { size: 12 } } }
        },
        cutout: '65%'
      }
    });
  }
})();
</script>
{% endblock %}
