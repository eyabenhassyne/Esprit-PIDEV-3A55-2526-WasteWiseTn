{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}QR Code Dashboard | WasteWise{% endblock %}
{% block page_title %}QR Code Analytics{% endblock %}

{% block body %}

  {# ===== HERO ===== #}
  <div class="hero d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <h2 class="mb-1">📊 QR Code Analytics Dashboard</h2>
      <div class="opacity-75">Suivi des scans par zone polluée</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-light" href="{{ path('app_zone_polluee_index') }}">
        <i class="fa-solid fa-location-dot me-2"></i> Zones Polluées
      </a>
    </div>
  </div>

  {# ===== STAT CARDS ===== #}
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Total Scans</div>
            <div class="fs-2 fw-bold">{{ totalScans }}</div>
            <div class="text-muted small">Tous les scans enregistrés</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(47,107,79,.12);color:#2f6b4f;">
            <i class="fa-solid fa-qrcode"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Zones Actives</div>
            <div class="fs-2 fw-bold">{{ zoneStats|length }}</div>
            <div class="text-muted small">Zones avec activité QR</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(141,210,47,.18);color:#2f6b4f;">
            <i class="fa-solid fa-map-marker-alt"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="stat-card h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div>
            <div class="text-muted small">Scans Récents</div>
            <div class="fs-2 fw-bold">{{ recentScans|length }}</div>
            <div class="text-muted small">10 derniers scans</div>
          </div>
          <div class="rounded-4 d-flex align-items-center justify-content-center"
               style="width:44px;height:44px;background:rgba(59,130,246,.12);color:#2563eb;">
            <i class="fa-solid fa-clock"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ===== RECENT SCANS TABLE ===== #}
  <div class="big-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="mb-0">🕐 Scans Récents</h5>
      <span class="badge bg-light text-dark border">{{ "now"|date("d/m/Y") }}</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Zone</th>
            <th>Date</th>
            <th>Appareil</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          {% for scan in recentScans %}
          <tr>
            <td class="fw-semibold">{{ scan.zone.nomZone }}</td>
            <td>{{ scan.scannedAt|date('d/m/Y H:i:s') }}</td>
            <td>
              {% if scan.deviceType == 'iPhone' %}
                <i class="fab fa-apple text-secondary me-1"></i>
              {% elseif scan.deviceType == 'Android' %}
                <i class="fab fa-android text-success me-1"></i>
              {% else %}
                <i class="fa-solid fa-desktop text-muted me-1"></i>
              {% endif %}
              {{ scan.deviceType ?? '—' }}
            </td>
            <td><small class="text-muted">{{ scan.ipAddress }}</small></td>
          </tr>
          {% else %}
          <tr>
            <td colspan="4" class="text-center py-5">
              <i class="fa-solid fa-qrcode fs-2 text-muted mb-2 d-block"></i>
              <span class="text-muted">Aucun scan pour le moment</span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# ===== ZONE STATS TABLE ===== #}
  <div class="big-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="mb-0">📍 Statistiques par Zone</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Zone</th>
            <th>Niveau Pollution</th>
            <th>Scans</th>
            <th>Dernier Scan</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {% for stat in zoneStats %}
          <tr>
            <td class="fw-bold">{{ stat.zone.nomZone }}</td>
            <td>
              <span class="badge bg-{{ stat.zone.niveauPollution >= 7 ? 'danger' : (stat.zone.niveauPollution >= 4 ? 'warning' : 'success') }}">
                {{ stat.zone.niveauPollution }}/10
              </span>
            </td>
            <td>{{ stat.count }}</td>
            <td>{{ stat.lastScan ? stat.lastScan.scannedAt|date('d/m/Y H:i') : '<span class="text-muted">Jamais</span>'|raw }}</td>
            <td>
              <a href="{{ path('app_zone_polluee_qr', {'id': stat.zone.id}) }}"
                 class="btn btn-sm btn-outline-success"
                 title="Voir QR Code">
                <i class="fa-solid fa-qrcode"></i>
              </a>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">Aucune zone enregistrée</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

{% endblock %}
