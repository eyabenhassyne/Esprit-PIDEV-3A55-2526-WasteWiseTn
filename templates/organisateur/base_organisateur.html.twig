{# templates/organisateur/base_organisateur.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Organisateur | WasteWise{% endblock %}</title>

  <link rel="stylesheet" href="{{ asset('assets/vendor/bootstrap/dist/css/bootstrap.min.css') }}">
  <link rel="stylesheet" href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}">
  <link rel="stylesheet" href="{{ asset('assets/vendor/font-awesome/css/all.min.css') }}">
  <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('assets/styles/app-I6UjZOl.css') }}">

  <style>
    .main-wrapper { display:flex; min-height:100vh; }
    .sidebar {
      width:270px; border-right:1px solid rgba(0,0,0,.08); background:#fff;
    }
    .page-wrapper { flex:1; background:#f8fafc; }
    .page-header { position:sticky; top:0; z-index:10; }
    .sidebar .nav-link {
      border-radius:10px; padding:.6rem .8rem; color:#334155;
      display:flex; align-items:center; gap:.45rem;
    }
    .sidebar .nav-link:hover { background:rgba(2,6,23,.05); }
    .sidebar .nav-link.active { background:#16a34a; color:#fff !important; font-weight:700; }
    @media(max-width:991px) {
      .main-wrapper { flex-direction:column; }
      .sidebar { width:100%; border-right:none; border-bottom:1px solid rgba(0,0,0,.08); }
    }
  </style>

  {% block stylesheets %}{% endblock %}
</head>
<body>

{% set route = app.request.attributes.get('_route') %}
{% set userLabel = app.user ? app.user.userIdentifier : 'User' %}
{% set firstChar = userLabel ? (userLabel|first|upper) : 'U' %}

<div class="main-wrapper">

  {# ===== SIDEBAR ===== #}
  <aside class="sidebar">

    <div class="p-3 border-bottom">
      <a href="{{ path('app_evenement_index') }}"
         class="d-flex align-items-center gap-2 text-decoration-none fw-bold text-success">
        <i class="bi bi-calendar-event"></i> WasteWise TN
      </a>
      <div class="small text-muted">Espace Organisateur</div>
    </div>

    <div class="p-3 border-bottom d-flex align-items-center gap-2">
      <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
           style="width:42px;height:42px;background:#e8f5ee;color:#166534;">
        {{ firstChar }}
      </div>
      <div class="min-w-0">
        <div class="fw-semibold text-truncate">{{ userLabel }}</div>
        <div class="small text-muted">Organisateur</div>
      </div>
    </div>

    <div class="px-2 py-3">
      <ul class="nav flex-column gap-1">

        {# ── Gestion Événement ── #}
        <li class="nav-item">
          <div class="text-muted px-2 mb-1" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;">
            Gestion événement
          </div>
        </li>

        <li class="nav-item">
          <a class="nav-link {{ route == 'app_evenement_index' ? 'active' : '' }}"
             href="{{ path('app_evenement_index') }}">
            <i class="bi bi-calendar3"></i> Mes événements
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link {{ route == 'app_evenement_new' ? 'active' : '' }}"
             href="{{ path('app_evenement_new') }}">
            <i class="bi bi-plus-circle"></i> Créer un événement
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link {{ route starts with 'app_participation_' ? 'active' : '' }}"
             href="{{ path('app_participation_index') }}">
            <i class="bi bi-people"></i> Participants
          </a>
        </li>

        <li class="nav-item mt-2">
          <a class="nav-link text-danger" href="{{ path('app_logout') }}">
            <i class="bi bi-box-arrow-right"></i> Déconnexion
          </a>
        </li>

      </ul>
    </div>
  </aside>

  {# ===== PAGE CONTENT ===== #}
  <div class="page-wrapper">
    <header class="page-header bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
      <div class="fw-bold">Espace Organisateur</div>
      {% if app.user %}
        <div class="d-flex align-items-center gap-3 small text-muted">
          <i class="bi bi-person-circle fs-5"></i>
          {{ app.user.userIdentifier }}
        </div>
      {% endif %}
    </header>

    <main class="px-4 py-4">
      {% for label, messages in app.flashes %}
        {% for message in messages %}
          {% set bs = label == 'error' ? 'danger' : label %}
          <div class="alert alert-{{ bs }} shadow-sm mb-3">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
  </div>
</div>

<script src="{{ asset('assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
