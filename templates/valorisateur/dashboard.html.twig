{% extends 'valorisateur/base_valorizateur.html.twig' %}

{% block title %}Dashboard | WasteWise Valorisateur{% endblock %}
{% block page_title %}Dashboard Valorisateur{% endblock %}

{% block body %}

<section class="hero mb-4">
  <h2 class="mb-1 fw-bold">Dashboard Valorisateur</h2>
  <p class="mb-3 opacity-75">Vue globale de votre performance de valorisation.</p>
  <div class="d-flex flex-wrap gap-2">
    <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,.2);font-size:.85rem;">Rendement: {{ rendement|default(0)|number_format(2) }}%</span>
    <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,.2);font-size:.85rem;">Kg valides: {{ totalKgValides|default(0)|number_format(2) }}</span>
    <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,.2);font-size:.85rem;">EcoPoints: {{ totalPoints ?? 0 }}</span>
  </div>
</section>

{% if weather is defined %}
<div class="big-card mb-4" style="background:linear-gradient(135deg,#ecfdf3,#f8fafc);border:1px solid #d1fae5;">
  {% if weather.available %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <p class="mb-1 fw-semibold text-secondary">🌤️ Meteo actuelle — {{ weather.city }}</p>
        <h3 class="mb-0 fw-800" style="color:#166534;font-size:2rem;">{{ weather.temperature|default(0)|round }}°C</h3>
      </div>
      <div class="text-end small text-dark">
        <p class="mb-1">💨 Vent: {{ weather.wind_speed|default(0) }} km/h</p>
        <p class="mb-1">🌦️ Code: {{ weather.weather_code|default('-') }}</p>
        <p class="mb-0">🕒 Maj: {{ weather.time|default('-') }}</p>
      </div>
    </div>
  {% else %}
    <p class="mb-0 fw-semibold text-secondary">⛅ {{ weather.message|default('Meteo indisponible') }}</p>
  {% endif %}
</div>
{% endif %}

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Declarations recues</p>
      <h4>{{ totalRecues ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Validees</p>
      <h4>{{ totalValidees ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Kg valides</p>
      <h4>{{ totalKgValides|default(0)|number_format(2) }}</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Rendement</p>
      <h4>{{ rendement|default(0)|number_format(2) }}%</h4>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Kg recus</p>
      <h4>{{ totalKgRecus|default(0)|number_format(2) }} kg</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>En attente</p>
      <h4>{{ totalEnAttente ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>EcoPoints generes</p>
      <h4>{{ totalPoints ?? 0 }}</h4>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="kpi-card">
      <p>Validations du jour</p>
      <h4>{{ validationsToday ?? 0 }} <small class="text-muted fs-6">({{ kgToday|default(0)|number_format(2) }} kg)</small></h4>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-7">
    <div class="big-card h-100" style="border-top:4px solid #22c55e;">
      <h5 class="mb-3"><i class="fa-solid fa-trophy text-success me-2"></i>Niveau valorisateur</h5>
      <p class="mb-2 fw-semibold">{{ badge ?? 'Bronze Recycler' }}</p>
      {% set progress = 100 %}
      {% if kgToNext is defined and kgToNext > 0 %}
        {% if badge == 'Bronze Recycler' %}{% set progress = ((100 - kgToNext) / 100 * 100)|round(0, 'common') %}
        {% elseif badge == 'Silver Recycler' %}{% set progress = ((301 - kgToNext - 101) / 200 * 100)|round(0, 'common') %}
        {% elseif badge == 'Gold Recycler' %}{% set progress = ((700 - kgToNext - 301) / 399 * 100)|round(0, 'common') %}
        {% endif %}
      {% endif %}
      {% if progress < 0 %}{% set progress = 0 %}{% endif %}
      {% if progress > 100 %}{% set progress = 100 %}{% endif %}
      <div class="progress mb-3" style="height:.8rem;border-radius:999px;">
        <div class="progress-bar bg-success" role="progressbar" style="width:{{ progress }}%;" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
          <span style="font-size:.68rem;font-weight:700;">{{ progress }}%</span>
        </div>
      </div>
      {% if kgToNext is defined and kgToNext > 0 %}
        <p class="text-muted mb-0">Encore {{ kgToNext|number_format(2) }} kg pour le prochain niveau.</p>
      {% else %}
        <p class="text-muted mb-0">Niveau maximum atteint — excellent travail.</p>
      {% endif %}
    </div>
  </div>
  <div class="col-lg-5">
    <div class="big-card h-100" style="border-top:4px solid #f59e0b;">
      <h5 class="mb-3"><i class="fa-solid fa-bell text-warning me-2"></i>Alertes</h5>
      {% if pendingAlert %}
        <div class="alert alert-danger py-2 mb-2">Attention : beaucoup de declarations en attente.</div>
      {% endif %}
      {% if noValidationAlert %}
        <div class="alert alert-warning py-2 mb-2">Aucune validation aujourd'hui.</div>
      {% endif %}
      {% if not pendingAlert and not noValidationAlert %}
        <div class="alert alert-success py-2 mb-0">Aucune alerte critique.</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <div class="big-card h-100">
      <h5 class="mb-2">Actions rapides</h5>
      <p class="text-muted mb-3">Accedez directement aux ecrans les plus utilises.</p>
      <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('valorisateur_dechets') }}" class="btn btn-vert rounded-pill px-3">Declarations</a>
        <a href="{{ path('valorisateur_valorisation') }}" class="btn btn-outline-success rounded-pill px-3">Valorisation</a>
        <a href="{{ path('valorisateur_statistiques') }}" class="btn btn-outline-secondary rounded-pill px-3">Statistiques</a>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="big-card h-100">
      <h5 class="mb-2">Synthese du jour</h5>
      <p class="mb-1">Declarations validees : <strong>{{ validationsToday ?? 0 }}</strong></p>
      <p class="mb-1">Kg traites aujourd'hui : <strong>{{ kgToday|default(0)|number_format(2) }} kg</strong></p>
      <p class="mb-0">Rendement actuel : <strong>{{ rendement|default(0)|number_format(2) }}%</strong></p>
    </div>
  </div>
</div>

{% endblock %}
