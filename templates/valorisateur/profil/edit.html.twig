{% extends 'valorisateur/base_valorizateur.html.twig' %}

{% block title %}Modifier Profil | WasteWise{% endblock %}

{% block stylesheets %}
<style>
  .edit-hero {
    background: linear-gradient(135deg, #0f2d1e 0%, #1e5c3a 60%, #2f7a4f 100%);
    border-radius: 20px;
    padding: 26px 32px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    box-shadow: 0 8px 32px rgba(15, 45, 30, 0.22);
  }

  .edit-hero-left { display: flex; align-items: center; gap: 18px; }

  .edit-hero-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(126, 211, 33, 0.18);
    border: 2px solid rgba(126, 211, 33, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
    color: #7ed321;
    flex-shrink: 0;
  }

  .edit-hero h4 { margin: 0 0 3px; font-weight: 800; }
  .edit-hero p { margin: 0; opacity: .7; font-size: .88rem; }

  .back-btn {
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.25);
    color: #fff;
    border-radius: 10px;
    padding: 9px 18px;
    font-size: .88rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: background .2s;
    white-space: nowrap;
  }
  .back-btn:hover { background: rgba(255,255,255,.22); color: #fff; }

  .form-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(15, 45, 30, 0.08);
    border: 1px solid rgba(47, 107, 79, 0.1);
    overflow: hidden;
  }

  .form-card-header {
    background: #f8faf9;
    border-bottom: 1px solid #e5ede9;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .form-card-header .header-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #0f2d1e, #2f6b4f);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7ed321;
    font-size: .85rem;
  }

  .form-card-body { padding: 28px 24px; }

  .form-label {
    font-weight: 600;
    font-size: .85rem;
    color: #374151;
    margin-bottom: 6px;
  }

  .form-control, .form-select {
    border: 1.5px solid #d1e7da;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: .92rem;
    background: #f8faf9;
    transition: border-color .2s, box-shadow .2s;
  }

  .form-control:focus, .form-select:focus {
    border-color: #2f6b4f;
    box-shadow: 0 0 0 3px rgba(47, 107, 79, 0.12);
    background: #fff;
  }

  .field-section {
    background: #f8faf9;
    border: 1px solid #e5ede9;
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 16px;
  }

  .field-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-weight: 700;
    font-size: .88rem;
    color: #374151;
  }

  .field-section-title .section-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .8rem;
  }

  .save-btn {
    background: linear-gradient(135deg, #0f2d1e, #2f6b4f);
    color: #7ed321;
    border: 1px solid rgba(126, 211, 33, 0.3);
    border-radius: 11px;
    padding: 12px 30px;
    font-weight: 700;
    font-size: .92rem;
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .save-btn:hover {
    background: linear-gradient(135deg, #1a4a2e, #3a8060);
    color: #a0e840;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(15, 45, 30, 0.3);
  }

  .cancel-btn {
    border: 1.5px solid #d1d5db;
    border-radius: 11px;
    padding: 12px 22px;
    font-size: .92rem;
    color: #6b7280;
    background: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all .15s;
  }

  .cancel-btn:hover {
    border-color: #9ca3af;
    color: #374151;
    background: #f9fafb;
  }
</style>
{% endblock %}

{% block body %}

{% set initials = (app.user.prenom ? app.user.prenom|slice(0,1) : (app.user.email|slice(0,1)))|upper %}

{# Hero #}
<div class="edit-hero">
  <div class="edit-hero-left">
    <div class="edit-hero-avatar">{{ initials }}</div>
    <div>
      <h4>Modifier mon profil</h4>
      <p>{{ app.user.email }}</p>
    </div>
  </div>
  <a href="{{ path('valorisateur_profile_show') }}" class="back-btn">
    <i class="bi bi-arrow-left"></i> Retour
  </a>
</div>

{# Flash messages #}
{% for label, messages in app.flashes %}
  {% for msg in messages %}
    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show rounded-3 mb-3">
      {{ msg }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}
{% endfor %}

<div class="row g-4">

  <div class="col-lg-8">
    <div class="form-card">
      <div class="form-card-header">
        <div class="header-icon"><i class="bi bi-pencil-fill"></i></div>
        <span style="font-weight:700; color:#1f2937;">Informations personnelles</span>
      </div>

      <div class="form-card-body">
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

        {# Identity #}
        <div class="field-section">
          <div class="field-section-title">
            <div class="section-icon" style="background:#e8f5ee; color:#2f6b4f;"><i class="bi bi-person-fill"></i></div>
            Identité
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              {{ form_label(form.prenom) }}
              {{ form_widget(form.prenom, { attr: { class: 'form-control', placeholder: 'Votre prénom' } }) }}
              {{ form_errors(form.prenom) }}
            </div>
            <div class="col-md-6">
              {{ form_label(form.nom) }}
              {{ form_widget(form.nom, { attr: { class: 'form-control', placeholder: 'Votre nom' } }) }}
              {{ form_errors(form.nom) }}
            </div>
          </div>
        </div>

        {# Contact #}
        <div class="field-section">
          <div class="field-section-title">
            <div class="section-icon" style="background:#eff6ff; color:#3b82f6;"><i class="bi bi-envelope-fill"></i></div>
            Contact
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              {{ form_label(form.email) }}
              {{ form_widget(form.email, { attr: { class: 'form-control', placeholder: 'votre@email.com' } }) }}
              {{ form_errors(form.email) }}
            </div>
            <div class="col-md-6">
              {{ form_label(form.telephone) }}
              {{ form_widget(form.telephone, { attr: { class: 'form-control', placeholder: '+216 XX XXX XXX' } }) }}
              {{ form_errors(form.telephone) }}
            </div>
          </div>
        </div>

        {# Password change #}
        {% if form.currentPassword is defined or form.newPassword is defined %}
        <div class="field-section">
          <div class="field-section-title">
            <div class="section-icon" style="background:#f3e8ff; color:#9333ea;"><i class="bi bi-lock-fill"></i></div>
            Changer le mot de passe <span style="font-weight:400; color:#9ca3af; font-size:.8rem;">(optionnel)</span>
          </div>
          <div class="row g-3">
            {% if form.currentPassword is defined %}
            <div class="col-md-6">
              {{ form_label(form.currentPassword) }}
              {{ form_widget(form.currentPassword, { attr: { class: 'form-control', placeholder: 'Mot de passe actuel' } }) }}
              {{ form_errors(form.currentPassword) }}
            </div>
            {% endif %}
            {% if form.newPassword is defined %}
            <div class="col-md-6">
              {{ form_label(form.newPassword) }}
              {{ form_widget(form.newPassword, { attr: { class: 'form-control', placeholder: 'Nouveau mot de passe' } }) }}
              {{ form_errors(form.newPassword) }}
            </div>
            {% endif %}
          </div>
        </div>
        {% endif %}

        {# Remaining fields #}
        {% for child in form %}
          {% if child.vars.name not in ['prenom', 'nom', 'email', 'telephone', 'currentPassword', 'newPassword', '_token'] %}
            <div class="mb-3">{{ form_row(child) }}</div>
          {% endif %}
        {% endfor %}

        <div class="d-flex gap-3 pt-2 border-top mt-2">
          <button type="submit" class="save-btn">
            <i class="bi bi-check2-circle"></i> Enregistrer les modifications
          </button>
          <a href="{{ path('valorisateur_profile_show') }}" class="cancel-btn">
            Annuler
          </a>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>

  {# Tips #}
  <div class="col-lg-4">
    <div style="background:linear-gradient(160deg,#f0f9f4,#e8f5ee);border-radius:18px;border:1px solid #c5ddd2;padding:22px;">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div style="width:30px;height:30px;background:#0f2d1e;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#7ed321;font-size:.85rem;">
          <i class="bi bi-lightbulb-fill"></i>
        </div>
        <span style="font-weight:700;color:#1f2937;">Conseils</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:0;">
        {% for tip in [
          ['bi bi-envelope-check', '#e8f5ee', '#2f6b4f', "Utilisez une adresse email valide pour recevoir les notifications."],
          ['bi bi-shield-lock', '#f3e8ff', '#9333ea', "Laissez le champ mot de passe vide si vous ne souhaitez pas le changer."],
          ['bi bi-telephone', '#eff6ff', '#3b82f6', "Un numéro de téléphone valide facilite la communication."]
        ] %}
        <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid rgba(47,107,79,.1);">
          <div style="width:28px;height:28px;background:{{ tip[1] }};border-radius:8px;display:flex;align-items:center;justify-content:center;color:{{ tip[2] }};font-size:.78rem;flex-shrink:0;margin-top:1px;">
            <i class="{{ tip[0] }}"></i>
          </div>
          <span style="font-size:.85rem;color:#374151;">{{ tip[3] }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

</div>

{% endblock %}
