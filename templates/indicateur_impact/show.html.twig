{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'citoyen/base.html.twig' %}

{% block title %}Indicateur #{{ indicateur.id }} | WasteWise{% endblock %}
{% block page_title %}Indicateur #{{ indicateur.id }}{% endblock %}

{% block body %}

  {# ===== BREADCRUMB ===== #}
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a href="{{ path('app_indicateur_impact_index') }}" class="text-decoration-none">Indicateurs</a>
      </li>
      <li class="breadcrumb-item active">Indicateur #{{ indicateur.id }}</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-lg-8">

      {# ===== STAT CARDS ===== #}
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="stat-card h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="text-muted small">Déchets récoltés</div>
                <div class="fs-2 fw-bold">{{ indicateur.totalKgRecoltes }} kg</div>
              </div>
              <div class="rounded-4 d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;background:rgba(239,68,68,.12);color:#dc2626;">
                <i class="fa-solid fa-trash-alt"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="stat-card h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="text-muted small">CO2 évité</div>
                <div class="fs-2 fw-bold">{{ indicateur.co2Evite }} kg</div>
              </div>
              <div class="rounded-4 d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;background:rgba(59,130,246,.12);color:#2563eb;">
                <i class="fa-solid fa-cloud"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="text-muted small">Date de calcul</div>
                <div class="fs-5 fw-bold">{{ indicateur.dateCalcul|date('d/m/Y H:i') }}</div>
              </div>
              <div class="rounded-4 d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;background:rgba(47,107,79,.12);color:#2f6b4f;">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      {# ===== ZONES ASSOCIÉES ===== #}
      <div class="big-card mb-4">
        <h5 class="mb-3">📍 Zones associées</h5>
        {% if indicateur.zonePolluees is not empty %}
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>Zone</th>
                  <th>Niveau de pollution</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {% for zone in indicateur.zonePolluees %}
                <tr>
                  <td class="fw-semibold">{{ zone.nomZone }}</td>
                  <td>
                    <span class="badge bg-{{ zone.niveauPollution <= 3 ? 'success' : (zone.niveauPollution <= 6 ? 'warning' : 'danger') }}">
                      {{ zone.niveauPollution }}/10
                    </span>
                  </td>
                  <td>
                    <a href="{{ path('app_zone_polluee_show', {'id': zone.id}) }}"
                       class="btn btn-sm btn-outline-secondary">
                      <i class="fa-solid fa-eye"></i>
                    </a>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p class="text-muted text-center py-3">
            <i class="fa-solid fa-location-dot me-2"></i>Aucune zone associée
          </p>
        {% endif %}
      </div>

      {# ===== ACTIONS ===== #}
      <div class="d-flex gap-2">
        <a href="{{ path('app_indicateur_impact_index') }}" class="btn btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-2"></i>Retour
        </a>
        <a href="{{ path('app_indicateur_impact_edit', {'id': indicateur.id}) }}" class="btn btn-success">
          <i class="fa-solid fa-pen me-2"></i>Modifier
        </a>
      </div>

    </div>
  </div>

{% endblock %}
