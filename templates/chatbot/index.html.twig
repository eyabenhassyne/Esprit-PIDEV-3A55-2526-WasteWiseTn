{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Assistant IA - WasteWise{% endblock %}
{% block page_title %}Assistant IA{% endblock %}

{% block stylesheets %}
<style>
  .chat-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  .chat-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(15, 54, 39, 0.10);
    overflow: hidden;
    border: 1px solid rgba(47, 107, 79, 0.12);
  }

  .chat-header {
    background: linear-gradient(135deg, #2f6b4f 0%, #4a9e6e 100%);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .chat-header-avatar {
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .chat-header-info h5 {
    margin: 0;
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .chat-header-info p {
    margin: 0;
    color: rgba(255,255,255,0.78);
    font-size: 0.82rem;
  }

  .chat-status-dot {
    width: 8px;
    height: 8px;
    background: #a8f0c6;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .chat-messages {
    height: 440px;
    overflow-y: auto;
    padding: 24px;
    background: #f8faf9;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chat-messages::-webkit-scrollbar { width: 5px; }
  .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-messages::-webkit-scrollbar-thumb { background: #c5ddd2; border-radius: 10px; }

  .chat-welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: #6b7280;
    gap: 12px;
  }

  .chat-welcome-icon {
    width: 72px;
    height: 72px;
    background: linear-gradient(135deg, #2f6b4f, #4a9e6e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: #fff;
    box-shadow: 0 6px 18px rgba(47, 107, 79, 0.28);
  }

  .chat-welcome h5 {
    font-weight: 700;
    color: #1f2937;
    margin: 0;
  }

  .chat-welcome p {
    margin: 0;
    font-size: 0.9rem;
    max-width: 320px;
  }

  .chat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 4px;
  }

  .chat-chip {
    background: #fff;
    border: 1px solid #c5ddd2;
    color: #2f6b4f;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .chat-chip:hover {
    background: #2f6b4f;
    color: #fff;
    border-color: #2f6b4f;
  }

  /* Message bubbles */
  .msg-row {
    display: flex;
    margin-bottom: 12px;
  }

  .msg-row.user {
    justify-content: flex-end;
  }

  .msg-row.bot {
    justify-content: flex-start;
  }

  .msg-bubble {
    max-width: 72%;
    padding: 12px 16px;
    border-radius: 18px;
    font-size: 0.92rem;
    line-height: 1.55;
    word-break: break-word;
  }

  .msg-row.user .msg-bubble {
    background: linear-gradient(135deg, #2f6b4f, #4a9e6e);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .msg-row.bot .msg-bubble {
    background: #fff;
    color: #1f2937;
    border: 1px solid #e5ede9;
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .msg-row.bot .msg-bubble.error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
  }

  .msg-label {
    font-size: 0.72rem;
    font-weight: 600;
    margin-bottom: 4px;
    opacity: 0.75;
  }

  .msg-row.user .msg-label { text-align: right; color: #4a9e6e; }
  .msg-row.bot .msg-label { color: #6b7280; }

  .msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 18px;
  }

  .msg-row.bot .msg-avatar {
    background: linear-gradient(135deg, #2f6b4f, #4a9e6e);
    color: #fff;
    margin-right: 8px;
  }

  .msg-row.user .msg-avatar {
    background: #e5ede9;
    color: #2f6b4f;
    margin-left: 8px;
  }

  /* Loading dots */
  .typing-dots {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 4px 0;
  }

  .typing-dots span {
    width: 7px;
    height: 7px;
    background: #9ca3af;
    border-radius: 50%;
    animation: bounce-dot 1.2s infinite;
  }

  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes bounce-dot {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
    40% { transform: translateY(-6px); opacity: 1; }
  }

  /* Input area */
  .chat-input-area {
    padding: 16px 20px;
    background: #fff;
    border-top: 1px solid #e5ede9;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .chat-input {
    flex: 1;
    border: 1.5px solid #d1e7da;
    border-radius: 24px;
    padding: 10px 18px;
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s;
    background: #f8faf9;
  }

  .chat-input:focus {
    border-color: #2f6b4f;
    background: #fff;
  }

  .chat-send-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2f6b4f, #4a9e6e);
    border: none;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s, box-shadow 0.15s;
    flex-shrink: 0;
    box-shadow: 0 3px 10px rgba(47, 107, 79, 0.3);
  }

  .chat-send-btn:hover {
    transform: scale(1.07);
    box-shadow: 0 5px 14px rgba(47, 107, 79, 0.4);
  }

  .chat-send-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  .chat-hint {
    padding: 8px 20px 14px;
    background: #fff;
    font-size: 0.78rem;
    color: #9ca3af;
    text-align: center;
  }
</style>
{% endblock %}

{% block body %}
<div class="chat-wrapper">

  <div class="chat-card">

    {# Header #}
    <div class="chat-header">
      <div class="chat-header-avatar">🤖</div>
      <div class="chat-header-info">
        <h5>Assistant IA WasteWise</h5>
        <p><span class="chat-status-dot"></span>En ligne · Spécialisé en gestion des déchets</p>
      </div>
    </div>

    {# Messages #}
    <div class="chat-messages" id="chatMessages">
      <div class="chat-welcome" id="welcomeMessage">
        <div class="chat-welcome-icon">🤖</div>
        <h5>Bonjour ! 👋</h5>
        <p>Comment puis-je vous aider avec la gestion des déchets aujourd'hui ?</p>
        <div class="chat-chips">
          <span class="chat-chip" onclick="askChip(this)">♻️ Recycler le plastique</span>
          <span class="chat-chip" onclick="askChip(this)">🔋 Déchets électroniques</span>
          <span class="chat-chip" onclick="askChip(this)">🌿 Impact du verre</span>
          <span class="chat-chip" onclick="askChip(this)">🗑️ Tri des déchets</span>
        </div>
      </div>
    </div>

    {# Input #}
    <div class="chat-input-area">
      <input
        type="text"
        class="chat-input"
        id="questionInput"
        placeholder="Posez votre question..."
        autocomplete="off"
      >
      <button class="chat-send-btn" id="sendBtn" onclick="sendMessage()" title="Envoyer">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>

    <div class="chat-hint">
      Exemples : "Comment recycler le plastique ?", "Que faire des déchets électroniques ?"
    </div>

  </div>

</div>

<script>
let msgCount = 0;

document.getElementById('questionInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

function askChip(el) {
  const text = el.textContent.replace(/^[^\w\s]+\s*/, '').trim();
  document.getElementById('questionInput').value = text;
  sendMessage();
}

function hideWelcome() {
  const w = document.getElementById('welcomeMessage');
  if (w) w.remove();
}

function addMessage(html) {
  const chat = document.getElementById('chatMessages');
  hideWelcome();
  chat.insertAdjacentHTML('beforeend', html);
  chat.scrollTop = chat.scrollHeight;
}

function sendMessage() {
  const input = document.getElementById('questionInput');
  const sendBtn = document.getElementById('sendBtn');
  const question = input.value.trim();
  if (!question) return;

  msgCount++;
  const loadingId = 'loading-' + msgCount;

  // User bubble
  addMessage(`
    <div class="msg-row user">
      <div>
        <div class="msg-label">Vous</div>
        <div class="msg-bubble">${escapeHtml(question)}</div>
      </div>
      <div class="msg-avatar"><i class="fa-solid fa-user"></i></div>
    </div>
  `);

  input.value = '';
  input.disabled = true;
  sendBtn.disabled = true;

  // Typing indicator
  addMessage(`
    <div class="msg-row bot" id="${loadingId}">
      <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
      <div>
        <div class="msg-label">Assistant</div>
        <div class="msg-bubble">
          <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
  `);

  fetch('{{ path('app_chatbot_ask') }}', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'question=' + encodeURIComponent(question)
  })
  .then(res => res.json())
  .then(data => {
    document.getElementById(loadingId)?.remove();
    const isError = data.answer && data.answer.startsWith('❌');
    addMessage(`
      <div class="msg-row bot">
        <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
        <div>
          <div class="msg-label">Assistant</div>
          <div class="msg-bubble${isError ? ' error' : ''}">${escapeHtml(data.answer ?? 'Pas de réponse.')}</div>
        </div>
      </div>
    `);
  })
  .catch(err => {
    document.getElementById(loadingId)?.remove();
    addMessage(`
      <div class="msg-row bot">
        <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
        <div>
          <div class="msg-label">Assistant</div>
          <div class="msg-bubble error">❌ Erreur réseau : ${escapeHtml(err.message)}</div>
        </div>
      </div>
    `);
  })
  .finally(() => {
    input.disabled = false;
    sendBtn.disabled = false;
    input.focus();
  });
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/\n/g, '<br>');
}
</script>
{% endblock %}
