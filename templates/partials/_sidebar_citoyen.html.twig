{# Unified Sidebar for Citoyen role #}

{% set route = app.request.attributes.get('_route') %}

<li class="nav-item">
  <a class="nav-link {{ route == 'app_dashboard_citoyen' ? 'active' : '' }}"
     href="{{ path('app_dashboard_citoyen') }}">
    <i class="bi bi-speedometer2"></i> Dashboard
  </a>
</li>

<li class="nav-item">
  <a class="nav-link {{ route starts with 'citoyen_profile_' ? 'active' : '' }}"
     href="{{ app.request.baseUrl }}/citoyen/profil">
    <i class="bi bi-person"></i> Mon Profil
  </a>
</li>

