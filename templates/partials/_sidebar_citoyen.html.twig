{% set route = app.request.attributes.get('_route') %}

{# ── Mon espace ── #}
<li class="sb-section-title">Mon espace</li>

<li>
  <a class="sb-link {{ route starts with 'citoyen_profile_' ? 'sb-active' : '' }}" href="{{ path('citoyen_profile_show') }}">
    <i class="fa-solid fa-user"></i><span>Mon Profil</span>
  </a>
</li>

{# ── Navigation principale ── #}
<li class="sb-section-title">Accueil</li>

<li>
  <a class="sb-link {{ route in ['app_dashboard_citoyen', 'citoyen_dashboard'] ? 'sb-active' : '' }}" href="{{ path('app_dashboard_citoyen') }}">
    <i class="fa-solid fa-house"></i><span>Accueil</span>
  </a>
</li>

{# ── Offres ── #}
<li class="sb-section-title">Offres</li>

<li>
  <a class="sb-link {{ route starts with 'app_appel_offre_' ? 'sb-active' : '' }}" href="{{ path('app_appel_offre_index') }}">
    <i class="fa-solid fa-briefcase"></i><span>Appels d'offres</span>
  </a>
</li>

<li>
  <a class="sb-link {{ route starts with 'app_reponse_offre_' and route != 'app_reponse_offre_new' ? 'sb-active' : '' }}" href="{{ path('app_reponse_offre_index') }}">
    <i class="fa-solid fa-comments"></i><span>Reponses offres</span>
  </a>
</li>

<li>
  <a class="sb-link {{ route == 'app_reponse_offre_new' ? 'sb-active' : '' }}" href="{{ path('app_reponse_offre_new') }}">
    <i class="fa-solid fa-plus"></i><span>Ajouter reponse</span>
  </a>
</li>

