{% set route = app.request.attributes.get('_route') %}

{# ── Mon espace ── #}
<li class="sb-section-title">Mon espace</li>

<li>
  <a class="sb-link {{ route starts with 'admin_profile' or route == 'app_user_profile' ? 'sb-active' : '' }}" href="{{ path('app_dashboard_admin') }}">
    <i class="fa-solid fa-user"></i><span>Mon Profil</span>
  </a>
</li>

{# ── Administration rapide ── #}
<li class="sb-section-title">Administration rapide</li>

<li>
  <a class="sb-link {{ route in ['app_dashboard_admin', 'admin_dashboard'] ? 'sb-active' : '' }}" href="{{ path('app_dashboard_admin') }}">
