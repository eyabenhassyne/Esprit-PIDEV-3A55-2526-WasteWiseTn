{# Unified Sidebar for all roles - Zones Polluées main focus #}

{% set route = app.request.attributes.get('_route') %}
{% set user = app.user %}
{% set userRoles = user ? user.roles : [] %}
{% set userType = user and attribute(user, 'type') is defined ? user.type : '' %}

{# ═══════════════════════════════════════════════════════════════ #}
{# MAIN SECTION - Available to all roles #}
{# ═══════════════════════════════════════════════════════════════ #}

{# Dashboard - Role-specific #}
{% if 'ROLE_ADMIN' in userRoles %}
  <li class="nav-item">
    <a class="nav-link {{ route == 'app_dashboard_admin' ? 'active' : '' }}"
       href="{{ path('app_dashboard_admin') }}">
      <i class="fa-solid fa-chart-line"></i>
      Dashboard
    </a>
  </li>
{% elseif 'ROLE_CITOYEN' in userRoles %}
  <li class="nav-item">
    <a class="nav-link {{ route == 'app_dashboard_citoyen' ? 'active' : '' }}"
       href="{{ path('app_dashboard_citoyen') }}">
      <i class="bi bi-speedometer2"></i>
      Dashboard
    </a>
  </li>
{% elseif 'ROLE_VALORISATEUR' in userRoles %}
  <li class="nav-item">
    <a class="nav-link {{ route == 'app_dashboard_valorizateur' ? 'active' : '' }}"
       href="{{ path('app_dashboard_valorizateur') }}">
      <i class="bi bi-speedometer2"></i>
      Dashboard
    </a>
  </li>
{% elseif 'ROLE_ORGANISATEUR' in userRoles %}
  <li class="nav-item">
    <a class="nav-link {{ route == 'app_evenement_index' ? 'active' : '' }}"
       href="{{ path('app_evenement_index') }}">
      <i class="bi bi-speedometer2"></i>
      Dashboard
    </a>
  </li>
{% endif %}

{# ═══════════════════════════════════════════════════════════════ #}
{# ZONES POLLUÉES SECTION - Main Focus #}
{# ═══════════════════════════════════════════════════════════════ #}

<li class="nav-item mt-3">
  <small style="opacity:.6; font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; padding:0 14px;">
    Zones Polluées
  </small>
</li>

{# Zones Polluées - HIGHLIGHTED IN GREEN #}
<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_zone_polluee_' ? 'active' : '' }}"
     href="{{ path('app_zone_polluee_index') }}"
     style="background: #16a34a; border-radius: 12px; color: white; margin: 12px 0;">
    <i class="fa-solid fa-location-dot"></i>
    Zones Polluées
  </a>
</li>

{# Indicateurs d'Impact #}
<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_indicateur_impact_' ? 'active' : '' }}"
     href="{{ path('app_indicateur_impact_index') }}">
    <i class="fa-solid fa-chart-line"></i>
    Indicateurs d'Impact
  </a>
</li>

{# Carte #}
<li class="nav-item">
  <a class="nav-link {{ route == 'app_map' ? 'active' : '' }}"
     href="{{ path('app_map') }}">
    <i class="fa-solid fa-map"></i>
    Carte
  </a>
</li>

{# Assistant IA #}
<li class="nav-item">
  <a class="nav-link {{ route == 'app_chatbot' ? 'active' : '' }}"
     href="{{ path('app_chatbot') }}"
     style="background: rgba(255,255,255,.15); border-radius: 12px; margin: 12px 0;">
    <i class="fa-solid fa-robot"></i>
    Assistant IA
  </a>
</li>

{# Dashboard IA #}
<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_dashboard_intelligent' ? 'active' : '' }}"
     href="{{ path('app_dashboard_intelligent') }}">
    <i class="fa-solid fa-brain"></i>
    Dashboard IA
  </a>
</li>

