{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Gestion des Zones Polluées{% endblock %}

{% block body %}

    {# ── Hero Banner ── #}
    <div class="hero mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="display-6 fw-bold mb-1">
                    <i class="fas fa-map-marker-alt me-2"></i>Zones Polluées
                </h1>
                <p class="mb-0 opacity-75">Gestion et suivi des zones de pollution environnementale</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('app_zone_polluee_qr_batch') }}" class="btn btn-light btn-sm px-3">
                    <i class="fas fa-qrcode me-2"></i>Tous les QR
                </a>
                <a href="{{ path('app_zone_polluee_new') }}" class="btn btn-sm px-3" style="background:#8bd22f; color:#1a3a28; font-weight:600; border:none;">
                    <i class="fas fa-plus me-2"></i>Nouvelle Zone
                </a>
            </div>
        </div>
    </div>

    {# ── Flash Messages ── #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ── Stats Cards ── #}
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px;height:52px;background:rgba(47,107,79,.12);">
                        <i class="fas fa-map-marker-alt fs-4" style="color:#2f6b4f;"></i>
                    </div>
                    <div>
                        <div class="text-muted small mb-1">Total Zones</div>
                        <div class="fs-2 fw-bold lh-1">{{ total_zones|default(0) }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px;height:52px;background:rgba(220,53,69,.10);">
                        <i class="fas fa-exclamation-triangle fs-4 text-danger"></i>
                    </div>
                    <div>
                        <div class="text-muted small mb-1">Haut Risque</div>
                        <div class="fs-2 fw-bold lh-1 text-danger">{{ haut_risque|default(0) }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px;height:52px;background:rgba(25,135,84,.12);">
                        <i class="fas fa-calendar-plus fs-4 text-success"></i>
                    </div>
                    <div>
                        <div class="text-muted small mb-1">Nouvelles Zones (7j)</div>
                        <div class="fs-2 fw-bold lh-1">{{ nouvelles_zones|default(0) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Search & Filters ── #}
    <div class="big-card mb-4">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Recherche</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0"
                               placeholder="Nom ou GPS..." value="{{ search|default('') }}">
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Filtrer par niveau</label>
                    <select name="filter" class="form-select">
                        <option value="">Tous les niveaux</option>
                        <option value="sup_5"   {{ current_filter == 'sup_5'   ? 'selected' : '' }}>Supérieur à 5</option>
                        <option value="inf_5"   {{ current_filter == 'inf_5'   ? 'selected' : '' }}>Inférieur ou égal à 5</option>
                        <option value="critique"{{ current_filter == 'critique'? 'selected' : '' }}>Critique (≥ 7)</option>
                        <option value="modere"  {{ current_filter == 'modere'  ? 'selected' : '' }}>Modéré (4-6)</option>
                        <option value="faible"  {{ current_filter == 'faible'  ? 'selected' : '' }}>Faible (≤ 3)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Trier par</label>
                    <select name="sort" class="form-select">
                        <option value="date_desc"  {{ current_sort == 'date_desc'  ? 'selected' : '' }}>Plus récent</option>
                        <option value="date_asc"   {{ current_sort == 'date_asc'   ? 'selected' : '' }}>Plus ancien</option>
                        <option value="nom_asc"    {{ current_sort == 'nom_asc'    ? 'selected' : '' }}>Nom (A-Z)</option>
                        <option value="nom_desc"   {{ current_sort == 'nom_desc'   ? 'selected' : '' }}>Nom (Z-A)</option>
                        <option value="niveau_desc"{{ current_sort == 'niveau_desc'? 'selected' : '' }}>Niveau (plus élevé)</option>
                        <option value="niveau_asc" {{ current_sort == 'niveau_asc' ? 'selected' : '' }}>Niveau (plus faible)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-vert flex-grow-1">
                            <i class="fas fa-filter me-1"></i>Filtrer
                        </button>
                        <a href="{{ path('app_zone_polluee_index') }}" class="btn btn-outline-secondary" title="Réinitialiser">
                            <i class="fas fa-redo"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    {# ── Table ── #}
    <div class="big-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0" style="color:#2f6b4f;">
                <i class="fas fa-list me-2"></i>Liste des zones
            </h6>
            <span class="badge rounded-pill" style="background:rgba(47,107,79,.12); color:#2f6b4f; font-size:.8rem;">
                {{ zones is defined ? zones|length : 0 }} zone(s)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr style="background:#f8faf9; border-bottom:2px solid #e8f0ec;">
                        <th class="fw-semibold text-muted small text-uppercase py-3" style="letter-spacing:.05em;">Zone</th>
                        <th class="fw-semibold text-muted small text-uppercase py-3" style="letter-spacing:.05em;">Coordonnées</th>
                        <th class="fw-semibold text-muted small text-uppercase py-3" style="letter-spacing:.05em;">Niveau</th>
                        <th class="fw-semibold text-muted small text-uppercase py-3" style="letter-spacing:.05em;">Date</th>
                        <th class="fw-semibold text-muted small text-uppercase py-3" style="letter-spacing:.05em;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if zones is defined and zones|length > 0 %}
                        {% for zone in zones %}
                        <tr>
                            <td class="fw-semibold">{{ zone.nomZone }}</td>
                            <td class="text-muted small">
                                <i class="fas fa-map-pin me-1 text-secondary"></i>{{ zone.coordonneesGps }}
                            </td>
                            <td>
                                {% if zone.niveauPollution <= 3 %}
                                    <span class="badge rounded-pill bg-success px-3 py-2">{{ zone.niveauPollution }}/10</span>
                                {% elseif zone.niveauPollution <= 6 %}
                                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2">{{ zone.niveauPollution }}/10</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger px-3 py-2">{{ zone.niveauPollution }}/10</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ zone.dateIdentification|date('d/m/Y') }}</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="{{ path('app_zone_polluee_show', {'id': zone.id}) }}"
                                       class="btn btn-sm btn-outline-secondary" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_zone_polluee_edit', {'id': zone.id}) }}"
                                       class="btn btn-sm btn-outline-primary" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="{{ path('app_zone_polluee_qr', {'id': zone.id}) }}"
                                       class="btn btn-sm btn-outline-secondary" title="QR Code">
                                        <i class="fas fa-qrcode"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_zone_polluee_delete', {'id': zone.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ zone.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"
                                                onclick="return confirm('Supprimer cette zone ?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="py-4">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width:72px;height:72px;background:rgba(47,107,79,.08);">
                                        <i class="fas fa-map-marker-alt fs-2" style="color:#2f6b4f;opacity:.5;"></i>
                                    </div>
                                    <h6 class="text-muted fw-semibold">Aucune zone polluée trouvée</h6>
                                    <p class="text-muted small mb-3">Cliquez sur "Nouvelle Zone" pour commencer</p>
                                    <a href="{{ path('app_zone_polluee_new') }}" class="btn btn-vert btn-sm px-4">
                                        <i class="fas fa-plus me-2"></i>Nouvelle Zone
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
