{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_VALORIZER') ? 'valorisateur/base_valorizateur.html.twig' : 'citoyen/base.html.twig') %}

{% block title %}Nouvelle Réponse d'offre | WasteWise{% endblock %}

{% block stylesheets %}
<style>
  .page-hero {
    background: linear-gradient(135deg, #0f2d1e 0%, #1e5c3a 60%, #2f7a4f 100%);
    border-radius: 20px;
    padding: 26px 32px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    box-shadow: 0 8px 32px rgba(15, 45, 30, 0.22);
  }

  .page-hero-left { display: flex; align-items: center; gap: 18px; }

  .page-hero-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(126, 211, 33, 0.18);
    border: 1px solid rgba(126, 211, 33, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #7ed321;
    flex-shrink: 0;
  }

  .page-hero h4 { margin: 0 0 3px; font-weight: 800; font-size: 1.25rem; }
  .page-hero p  { margin: 0; opacity: .72; font-size: .88rem; }

  .back-btn {
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.25);
    color: #fff;
    border-radius: 10px;
    padding: 9px 18px;
    font-size: .88rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: background .2s;
    white-space: nowrap;
  }
  .back-btn:hover { background: rgba(255,255,255,.22); color: #fff; }

  .form-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(15, 45, 30, 0.09);
    border: 1px solid rgba(47, 107, 79, 0.1);
    overflow: hidden;
  }

  .form-card-header {
    background: linear-gradient(135deg, #0f2d1e, #2f6b4f);
    padding: 18px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .form-card-header span {
    font-weight: 700;
    color: #fff;
    font-size: .95rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-card-header .badge-new {
    background: rgba(126, 211, 33, 0.2);
    border: 1px solid rgba(126, 211, 33, 0.4);
    color: #7ed321;
    border-radius: 20px;
    padding: 3px 12px;
    font-size: .75rem;
    font-weight: 700;
  }

  .form-card-body { padding: 30px 28px; }

  .field-group {
    background: #f8faf9;
    border: 1px solid #e5ede9;
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 16px;
  }

  .field-group-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-weight: 700;
    font-size: .88rem;
    color: #374151;
  }

  .field-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .8rem;
    flex-shrink: 0;
  }

  .form-label {
    font-weight: 600;
    font-size: .83rem;
    color: #374151;
    margin-bottom: 6px;
    display: block;
  }

  .form-control, .form-select {
    border: 1.5px solid #d1e7da;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: .92rem;
    background: #fff;
    width: 100%;
    transition: border-color .2s, box-shadow .2s;
    color: #1f2937;
  }

  .form-control:focus, .form-select:focus {
    border-color: #2f6b4f;
    box-shadow: 0 0 0 3px rgba(47, 107, 79, 0.12);
    outline: none;
  }

  textarea.form-control { resize: vertical; min-height: 110px; }

  .submit-btn {
    background: linear-gradient(135deg, #0f2d1e, #2f6b4f);
    color: #7ed321;
    border: 1px solid rgba(126, 211, 33, 0.3);
    border-radius: 11px;
    padding: 12px 30px;
    font-weight: 700;
    font-size: .92rem;
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .submit-btn:hover {
    background: linear-gradient(135deg, #1a4a2e, #3a8060);
    color: #a0e840;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(15, 45, 30, 0.3);
  }

  .cancel-link {
    border: 1.5px solid #d1d5db;
    border-radius: 11px;
    padding: 12px 22px;
    font-size: .92rem;
    color: #6b7280;
    background: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all .15s;
  }
  .cancel-link:hover {
    border-color: #9ca3af;
    color: #374151;
    background: #f9fafb;
  }

  .tips-card {
    background: linear-gradient(160deg, #f0f9f4, #e8f5ee);
    border-radius: 18px;
    border: 1px solid #c5ddd2;
    padding: 22px;
    height: fit-content;
  }

  .tip-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(47,107,79,.1);
    font-size: .85rem;
    color: #374151;
  }
  .tip-row:last-child { border-bottom: none; padding-bottom: 0; }

  .tip-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
</style>
{% endblock %}

{% block body %}

{# Hero #}
<div class="page-hero">
  <div class="page-hero-left">
    <div class="page-hero-icon">
      <i class="fa-solid fa-reply"></i>
    </div>
    <div>
      <h4>Créer une réponse d'offre</h4>
      <p>Proposez votre réponse à un appel d'offre publié</p>
    </div>
  </div>
  <a href="{{ path('app_reponse_offre_index') }}" class="back-btn">
    <i class="bi bi-arrow-left"></i> Retour à la liste
  </a>
</div>

{# Flash messages #}
{% for label, messages in app.flashes %}
  {% for msg in messages %}
    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show rounded-3 mb-3">
      {{ msg }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}
{% endfor %}

<div class="row g-4 align-items-start">

  {# Form #}
  <div class="col-lg-8">
    <div class="form-card">

      <div class="form-card-header">
        <span><i class="fa-solid fa-pen-to-square"></i> Formulaire de réponse</span>
        <span class="badge-new">Nouvelle</span>
      </div>

      <div class="form-card-body">
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

        {# Appel d'offre #}
        <div class="field-group">
          <div class="field-group-title">
            <div class="field-icon" style="background:#e8f5ee; color:#2f6b4f;">
              <i class="fa-solid fa-briefcase"></i>
            </div>
            Appel d'offre concerné
          </div>
          {{ form_label(form.appelOffre, 'Sélectionner un appel d\'offre', { label_attr: { class: 'form-label' } }) }}
          {{ form_widget(form.appelOffre, { attr: { class: 'form-select' } }) }}
          {{ form_errors(form.appelOffre) }}
        </div>

        {# Quantité #}
        <div class="field-group">
          <div class="field-group-title">
            <div class="field-icon" style="background:#fef3c7; color:#d97706;">
              <i class="fa-solid fa-weight-hanging"></i>
            </div>
            Quantité proposée
          </div>
          {{ form_label(form.quantiteProposee, 'Quantité (en kg ou unités)', { label_attr: { class: 'form-label' } }) }}
          {{ form_widget(form.quantiteProposee, { attr: { class: 'form-control', placeholder: 'Ex: 50' } }) }}
          {{ form_errors(form.quantiteProposee) }}
          <div style="font-size:.78rem; color:#9ca3af; margin-top:5px;">
            <i class="bi bi-info-circle me-1"></i>Indiquez la quantité de déchets que vous proposez
          </div>
        </div>

        {# Message #}
        <div class="field-group">
          <div class="field-group-title">
            <div class="field-icon" style="background:#eff6ff; color:#3b82f6;">
              <i class="fa-solid fa-message"></i>
            </div>
            Message
          </div>
          {{ form_label(form.message, 'Votre message', { label_attr: { class: 'form-label' } }) }}
          {{ form_widget(form.message, { attr: { class: 'form-control', placeholder: 'Décrivez votre réponse, les conditions, la disponibilité...' } }) }}
          {{ form_errors(form.message) }}
        </div>

        {# Actions #}
        <div class="d-flex gap-3 pt-2 border-top mt-2">
          <button type="submit" class="submit-btn">
            <i class="bi bi-check2-circle"></i> Enregistrer la réponse
          </button>
          <a href="{{ path('app_reponse_offre_index') }}" class="cancel-link">
            Annuler
          </a>
        </div>

        {{ form_end(form) }}
      </div>

    </div>
  </div>

  {# Tips #}
  <div class="col-lg-4">
    <div class="tips-card">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div style="width:30px;height:30px;background:#0f2d1e;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#7ed321;font-size:.85rem;">
          <i class="bi bi-lightbulb-fill"></i>
        </div>
        <span style="font-weight:700; color:#1f2937;">Conseils</span>
      </div>

      <div class="tip-row">
        <div class="tip-icon" style="background:#e8f5ee; color:#2f6b4f;"><i class="bi bi-briefcase"></i></div>
        <span>Choisissez l'appel d'offre qui correspond à vos déchets disponibles.</span>
      </div>
      <div class="tip-row">
        <div class="tip-icon" style="background:#fef3c7; color:#d97706;"><i class="bi bi-123"></i></div>
        <span>Indiquez une quantité réaliste que vous pouvez réellement fournir.</span>
      </div>
      <div class="tip-row">
        <div class="tip-icon" style="background:#eff6ff; color:#3b82f6;"><i class="bi bi-chat-text"></i></div>
        <span>Un message clair et détaillé augmente vos chances d'être sélectionné.</span>
      </div>
      <div class="tip-row">
        <div class="tip-icon" style="background:#fce7f3; color:#db2777;"><i class="bi bi-clock"></i></div>
        <span>Vérifiez que l'appel d'offre n'est pas expiré avant de soumettre.</span>
      </div>
    </div>

    {# Status info #}
    <div style="background:#fff;border-radius:16px;border:1px solid rgba(47,107,79,.1);padding:18px 20px;margin-top:16px;box-shadow:0 2px 10px rgba(15,45,30,.06);">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div style="width:28px;height:28px;background:#fef3c7;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#d97706;font-size:.8rem;">
          <i class="bi bi-info-circle-fill"></i>
        </div>
        <span style="font-weight:700; color:#1f2937; font-size:.9rem;">Statut de la réponse</span>
      </div>
      <p style="font-size:.84rem; color:#6b7280; margin:0;">
        Votre réponse sera soumise avec le statut <strong style="color:#d97706;">En attente</strong> et sera examinée par un valorisateur.
      </p>
    </div>
  </div>

</div>

{% endblock %}
