<button type="button"
        class="usr-btn usr-btn--danger usr-btn--icon"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal{{ user.id }}"
        title="Supprimer">
  <i class="fa-solid fa-trash"></i>
</button>

<div class="modal fade" id="deleteModal{{ user.id }}">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:18px; border:none; overflow:hidden;">

      <div class="modal-header" style="background:#fff5f5; border-bottom:1px solid #fde8e8;">
        <h5 class="modal-title" style="color:#9f2f2f; font-weight:700;">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Supprimer l'utilisateur
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body" style="padding:20px 24px; color:#374151;">
        Confirmer la suppression de <strong>{{ user.email }}</strong> ?
        <div class="mt-2" style="font-size:.85rem; color:#9f2f2f;">
          <i class="fa-solid fa-circle-info me-1"></i>Cette action est irréversible.
        </div>
      </div>

      <div class="modal-footer" style="border-top:1px solid #f0f0f0; gap:8px;">
        <button class="usr-btn usr-btn--ghost" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="margin:0;">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
          <button type="submit" class="usr-btn" style="background:#c94848; color:#fff; border:none;">
            <i class="fa-solid fa-trash me-1"></i>Supprimer
          </button>
        </form>
      </div>

    </div>
  </div>
</div>
