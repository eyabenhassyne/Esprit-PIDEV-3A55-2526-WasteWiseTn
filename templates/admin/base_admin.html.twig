{# templates/admin/base_admin.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Admin | WasteWise{% endblock %}</title>

  <link rel="shortcut icon" href="{{ asset('static/images/logo.png') }}" type="image/png">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body{ margin:0; font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif; background:#f4f6f5; }
    .layout{ display:flex; min-height:100vh; }

    .sidebar{
      width:260px; min-width:260px; flex-shrink:0;
      background:#0f2d1e; color:#fff; padding:0;
      display:flex; flex-direction:column; position:sticky; top:0; height:100vh;
      overflow-y:auto; overflow-x:hidden;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      padding:20px 18px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }
    .brand .logo{
      width:38px; height:38px; border-radius:10px;
      background:rgba(255,255,255,.12); display:grid; place-items:center;
      font-weight:900; font-size:1.1rem;
    }

    /* New sidebar nav classes */
    .sb-section-title{
      color:rgba(255,255,255,.42);
      font-size:.7rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.1em;
      padding:18px 18px 6px;
      list-style:none;
      display:block;
    }

    .sb-link{
      display:flex;
      align-items:center;
      gap:12px;
      padding:11px 14px;
      margin:1px 10px;
      border-radius:10px;
      color:rgba(255,255,255,.75);
      text-decoration:none;
      font-size:.93rem;
      font-weight:500;
      transition:background .18s, color .18s;
    }
    .sb-link i{
      width:18px;
      text-align:center;
      font-size:.92rem;
      flex-shrink:0;
    }
    .sb-link:hover{
      background:rgba(255,255,255,.08);
      color:#fff;
    }
    .sb-link.sb-active{
      background:#7ed321;
      color:#0f2d1e;
      font-weight:700;
    }
    .sb-link.sb-active i{
      color:#0f2d1e;
    }

    /* Keep old classes working for logout link */
    .sidebar .nav-link{
      color:rgba(255,255,255,.75);
      padding:11px 14px; border-radius:10px; margin:1px 10px;
      transition:.18s; display:flex; align-items:center; gap:12px;
      font-size:.93rem; font-weight:500; text-decoration:none;
    }
    .sidebar .nav-link i{ width:18px; text-align:center; font-size:.92rem; }
    .sidebar .nav-link:hover{ background:rgba(255,255,255,.08); color:#fff; }
    .sidebar .nav-link.active{ background:#7ed321; color:#0f2d1e; font-weight:700; }
    .sidebar-section-title{
      color:rgba(255,255,255,.42); font-size:.7rem; font-weight:600;
      text-transform:uppercase; letter-spacing:.1em; padding:18px 18px 6px;
    }
    .sidebar .nav-link.nav-link-logout{ color:#ffa0a0; }
    .sidebar .nav-link.nav-link-logout:hover{ background:rgba(255,80,80,.18); color:#fff; }
    .sidebar-footer{
      margin:12px;
      border-radius:14px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.1);
      padding:12px;
    }

    .main-area{ flex:1; display:flex; flex-direction:column; min-width:0; }
    .top-header{
      background:#fff; padding:16px 26px; border-bottom:1px solid #e7e7e7;
      display:flex; justify-content:space-between; align-items:center; gap:12px;
    }
    .main-content{ padding:26px; }

    .hero{
      background:linear-gradient(90deg,#2f6b4f,#8bd22f);
      color:#fff; padding:34px; border-radius:20px; margin-bottom:22px;
      box-shadow:0 14px 40px rgba(0,0,0,.08);
    }

    .stat-card{
      background:#fff; border-radius:18px; padding:22px;
      box-shadow:0 5px 15px rgba(0,0,0,.08); transition:.25s;
      border:1px solid rgba(0,0,0,.04);
    }
    .stat-card:hover{ transform:translateY(-5px); }

    .big-card{
      background:#fff; border-radius:18px; padding:26px;
      box-shadow:0 5px 20px rgba(0,0,0,.08);
      border:1px solid rgba(0,0,0,.04);
    }

    .btn-vert{
      background:linear-gradient(135deg,#2f6b4f,#4a9e6e);
      color:#fff; border:none;
    }
    .btn-vert:hover, .btn-vert:focus{
      background:linear-gradient(135deg,#245840,#3a8a5c);
      color:#fff;
    }

    @media (max-width: 992px){
      .sidebar{ width:240px; min-width:240px; }
    }
    @media (max-width: 768px){
      .layout{ flex-direction:column; }
      .sidebar{ width:100%; min-width:unset; height:auto; position:relative; }
    }
  </style>

  {% block stylesheets %}{% endblock %}
  {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>
{% set route = app.request.attributes.get('_route') %}

<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <div class="logo"><img src="{{ asset('static/images/logo.png') }}" alt="WasteWise" style="width:28px;height:28px;object-fit:contain;border-radius:6px;"></div>
      <div>
        <div style="font-weight:900; line-height:1; color:#fff;">WasteWise</div>
        <small style="color:rgba(255,255,255,.55); font-size:.75rem;">Admin panel</small>
      </div>
    </div>

    <ul class="nav flex-column" style="padding:8px 0; list-style:none; margin:0;">
      {% block sidebar %}
        {% include 'partials/_sidebar_admin.html.twig' %}
      {% endblock %}
    </ul>

    {% if app.user %}
      <div class="sidebar-footer" style="margin-top:auto;">
        <div class="fw-semibold text-truncate" style="color:#fff;">{{ app.user.userIdentifier }}</div>
        <div class="small mb-2" style="color:rgba(255,255,255,.55);">ADMIN</div>
        <a class="nav-link nav-link-logout mb-0 p-0" href="{{ path('app_logout') }}">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Deconnexion</span>
        </a>
      </div>
    {% endif %}

  </aside>

  <!-- MAIN -->
  <div class="main-area">
    <header class="top-header">
      <div>
        <h5 class="mb-0">{% block page_title %}Dashboard{% endblock %}</h5>
        <small class="text-muted">WasteWise TN • Administration</small>
      </div>

      {% if app.user %}
        <div class="text-end">
          <strong>{{ app.user.userIdentifier }}</strong><br>
          <small class="text-muted">Admin</small>
        </div>
      {% endif %}
    </header>

    <main class="main-content">
      {% block body %}{% endblock %}
    </main>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
