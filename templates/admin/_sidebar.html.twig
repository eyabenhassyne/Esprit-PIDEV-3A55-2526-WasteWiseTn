{# templates/admin/_sidebar.html.twig #}

{% set route = app.request.attributes.get('_route') %}

<li class="nav-item">
  <a class="nav-link {{ route == 'app_dashboard_admin' ? 'active' : '' }}"
     href="{{ path('app_dashboard_admin') }}">
    <i class="fa-solid fa-chart-line"></i>
    Dashboard
  </a>
</li>

<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_user_' ? 'active' : '' }}"
     href="{{ path('app_user_index') }}">
    <i class="fa-solid fa-users"></i>
    Gestion des utilisateurs
  </a>
</li>

{# ── Gestion Organisateur (Islem) ── #}
<li class="nav-item mt-3">
  <small style="opacity:.6; font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; padding:0 14px;">
    Gestion organisateur
  </small>
</li>

<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_evenement_' ? 'active' : '' }}"
     href="{{ path('app_evenement_index') }}">
    <i class="fa-solid fa-calendar-days"></i>
    Événements
  </a>
</li>

<li class="nav-item">
  <a class="nav-link {{ route starts with 'app_participation_' ? 'active' : '' }}"
     href="{{ path('app_participation_index') }}">
    <i class="fa-solid fa-users-line"></i>
    Participations
  </a>
</li>

<li class="nav-item mt-3">
  <a class="nav-link text-danger"
     href="{{ path('app_logout') }}">
    <i class="fa-solid fa-right-from-bracket"></i>
    Déconnexion
  </a>
</li>