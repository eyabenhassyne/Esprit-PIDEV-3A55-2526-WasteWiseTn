{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Admin - Detail type de dechet{% endblock %}


{% block body %}
<div class="hero">
    <h2>Detail du type de dechet</h2>
    <p class="mb-0">Consultez les informations utilisees par le systeme de points.</p>
</div>

<div class="container-fluid px-0 mt-4">
    <div class="big-card">
        <div class="row g-3">
            <div class="col-md-3"><p class="text-muted mb-1">ID</p><h5 class="mb-0">{{ type_dechet.id }}</h5></div>
            <div class="col-md-3"><p class="text-muted mb-1">Libelle</p><h5 class="mb-0">{{ type_dechet.libelle }}</h5></div>
            <div class="col-md-3"><p class="text-muted mb-1">Points/kg</p><h5 class="mb-0">{{ type_dechet.valeurPointsKg }}</h5></div>
            <div class="col-md-3"><p class="text-muted mb-1">Description tri</p><h5 class="mb-0">{{ type_dechet.descriptionTri }}</h5></div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a href="{{ path('app_typedechet_index') }}" class="btn btn-outline-secondary rounded-pill px-4">Retour</a>
            <a href="{{ path('app_typedechet_edit', {'id': type_dechet.id}) }}" class="btn btn-primary rounded-pill px-4">Modifier</a>
        </div>
    </div>
</div>
{% endblock %}
