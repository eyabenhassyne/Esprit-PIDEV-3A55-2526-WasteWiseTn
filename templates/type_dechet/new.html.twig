{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Admin - Ajouter type de dechet{% endblock %}


{% block body %}
<div class="hero">
    <h2>Ajouter un type de dechet</h2>
    <p class="mb-0">Ajoutez une nouvelle categorie et sa valeur de points par kilo.</p>
</div>

<div class="container-fluid px-0 mt-4">
    <div class="big-card">
        {{ form_start(form, {'attr': {'id': 'typeForm', 'novalidate': 'novalidate'}}) }}

        <div class="row g-3">
            <div class="col-md-6">
                {{ form_row(form.libelle, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.valeurPointsKg, {'attr': {'class': 'form-control', 'min': 0}}) }}
            </div>
            <div class="col-12">
                {{ form_row(form.descriptionTri, {'attr': {'class': 'form-control', 'rows': 4}}) }}
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success rounded-pill px-4">Enregistrer</button>
            <a href="{{ path('app_typedechet_index') }}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
